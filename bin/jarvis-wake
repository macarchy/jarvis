#!/usr/bin/env bash
# Launcher for the wake-word daemon: venv python, single instance.
set -uo pipefail
JARVIS_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
RUN_DIR="${JARVIS_RUN:-${XDG_RUNTIME_DIR:-/tmp}/jarvis}"
mkdir -p "$RUN_DIR"
# The lock is held for the daemon's whole life, and that is also how the
# FSM answers "is the ear open?" (wake_alive) — keep it in $RUN_DIR so a
# sandboxed daemon and a sandboxed jarvis look at the same file.
exec 9>"$RUN_DIR/wake.lock"
flock -n 9 || { echo "jarvis-wake: already running" >&2; exit 1; }
exec "$JARVIS_DIR/wake/venv/bin/python" "$JARVIS_DIR/bin/jarvis-wake.py"
