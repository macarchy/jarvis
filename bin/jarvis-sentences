#!/usr/bin/env python3
"""jarvis-sentences — turn a claude stream into speakable sentences,
and trace everything the brain does along the way.

Reads `claude -p --output-format stream-json --include-partial-messages`
on stdin and emits one complete sentence per line, unbuffered, as soon as
each boundary arrives — so the voice can start on sentence one while the
brain still writes sentence two. The full reply is written to argv[1]
when the stream ends — and also when it does not: a reader that walks away
mid-stream (a barge-in) gets whatever had arrived, plus an
<reply-file>.interrupted marker, rather than an empty file the pipeline
would read as a brain that answered nothing.

Usage: jarvis-sentences [--quiet] <reply-file>
  --quiet   no sentence output (dreams, heartbeats, missions: the caller
            only wants the final text and the trace). The file then holds
            the LAST text block only — the report, not the narration. Every
            round used to come back as « Je fais ma ronde. Un instant. RAS »,
            and a report that is not exactly « RAS » is a finding: eight
            rounds on 2026-09-01 were journaled, notified and worried about
            for having said, in effect, nothing.

Three sidecars beside the reply file say what the session itself reported:
  <reply-file>.error    the CLI reporting on itself (a usage limit, a lost
                        session, a connection error) — never a reply
  <reply-file>.status   `ok` or `error`, from the result event, so the FSM
                        can trust a successful answer whatever words it
                        contains instead of reading « rate limit » in a
                        digested article as an outage of its own brain
  <reply-file>.denied   the tool description of the FIRST permission denial
                        (a settings.json allowlist gap) — the trace records
                        it too, but dreams read FAILURES.md, not the trace,
                        so a missing allowlist row never taught them anything
All are removed on start: a stale verdict from yesterday's failure must not
be read as today's.

Emotion tags: the brain writes "<<proud>>" inline in its spoken text. They
never reach the voice — stripped like the markdown below — and never reach
the reply file either. Instead each one prints on its own stdout line,
right before the sentence line it rode in on, so bin/jarvis can hand it to
the mascot without the brain having to spend a whole tool call on saying
how it feels.

The black box: every tool call the brain makes (and its outcome) is
appended to memory/trace/YYYY-MM-DD.log — one compact line per event.
That file is how Jarvis can answer "pourquoi as-tu fait ça ?" and how his
dreams find the root cause behind a noted failure.

Thinking deltas are ignored; text from intermediate assistant turns (the
words spoken before a tool runs) flows through like any other — Jarvis
narrating what he's doing mid-action is a feature.
"""

import json
import os
import re
import sys
import time

args = sys.argv[1:]
quiet = "--quiet" in args
out_path = [a for a in args if not a.startswith("--")][0]

JARVIS_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
# JARVIS_MEMORY relocates the whole memory, exactly as it does for the FSM
# and for jarvis-index: without it the test suite kept appending imaginary
# quota notices and API errors to the real black box, and Jarvis's dreams
# read them as evidence.
MEMORY = os.environ.get("JARVIS_MEMORY") or os.path.join(JARVIS_DIR, "memory")
TRACE_DIR = os.path.join(MEMORY, "trace")
TRACE = os.path.join(TRACE_DIR, time.strftime("%Y-%m-%d") + ".log")

# A sentence ends at . ! ? … or : (optionally inside quotes/brackets)
# followed by whitespace. Newlines count as whitespace; markdown never
# reaches the voice anyway (the soul forbids it).
# A number followed by a full stop — « 1. work-cd », « 2. work-4c » — is a
# list marker, not the end of a sentence: cut there, the voice said « un. »
# then paused, then went on (2026-09-02 12:40). Lookbehinds must be fixed
# width, so one per length: the marker is one or two digits, at the start
# or after whitespace.
BOUNDARY = re.compile(r'[.!?…:]["»)\]]?[ \t]*\n'
                      r'|(?<!^\d)(?<!\s\d)(?<!^\d\d)(?<!\s\d\d)[.!?…]["»)\]]?[ \t]+')

# The soul forbids markdown and the brain writes it anyway on anything
# list-shaped (« 1. **work-cd** », 2026-09-02). espeak swallows most of
# it — underscores, backticks, bullets, a leading # — but reads every
# asterisk out loud, « astérisque astérisque work-cd astérisque
# astérisque », and a ~~ as « tilde tilde ». Those two stop here.
VOICED_MARKUP = re.compile(r"\*+|~~")

# An emotion tag the brain drops inline, e.g. "<<proud>>". Never spoken,
# never written to the reply file — see the module docstring. Case-insensitive
# because a tag opening a sentence is exactly where a model capitalizes, and
# « <<Proud>> » unmatched is not a silent miss: it reaches piper, which reads
# the angle brackets out loud.
EMOTE_TAG = re.compile(r"<<([a-z]+)>>", re.I)

# The CLI reporting on itself rather than answering — a usage limit.
LIMIT = re.compile(r"(hit|reached) your .*limit|usage limit|rate limit", re.I)

buf = ""
full = ""
turn = ""                       # the current (hence, at the end, the last) text block
got_delta = False
status = None                   # ok | error, once the result event has said
errored = False                 # the first report on the session wins
tool_names = {}                 # tool_use_id -> "Bash: omarchy ..."

for stale in (".error", ".status", ".denied"):
    try:
        os.remove(out_path + stale)
    except OSError:
        pass


def trace(line):
    os.makedirs(TRACE_DIR, exist_ok=True)
    with open(TRACE, "a") as f:
        f.write(f"{time.strftime('%H:%M:%S')} {line}\n")


def error(text):
    """A session error is not a reply: it goes to <reply-file>.error for
    the FSM to classify (quota, lost session…) and never to the voice.
    The first report wins: the CLI says a usage limit twice, once as a
    synthetic assistant message and once as the result, and the second
    can be a bare subtype that says less."""
    global errored, status
    trace(f"✗ session: {squash(text)}")
    status = "error"
    if errored:
        return
    errored = True
    with open(out_path + ".error", "w") as f:
        f.write(" ".join(str(text).split()))


def squash(value, limit=200):
    text = " ".join(str(value).split())
    return text[:limit] + "…" if len(text) > limit else text


def describe_tool(block):
    name = block.get("name", "?")
    inp = block.get("input", {}) or {}
    if name == "Bash":
        detail = inp.get("command", "")
    elif name in ("Read", "Edit", "Write"):
        detail = inp.get("file_path", "")
    elif name == "WebSearch":
        detail = inp.get("query", "")
    else:
        detail = json.dumps(inp, ensure_ascii=False)
    return f"{name}: {squash(detail)}"


def separate():
    """Text blocks arrive back to back ("Un instant.RAS"): insert a
    space between two blocks when the first ends mid-line."""
    global buf, full
    if full and not full[-1].isspace():
        buf += " "
        full += " "


def emit(text):
    tags = EMOTE_TAG.findall(text)
    text = " ".join(VOICED_MARKUP.sub("", EMOTE_TAG.sub("", text)).split())
    if quiet:
        return
    # The tag line comes FIRST, before the sentence it rode in on, so the
    # mascot hears the emotion in the order the brain wrote it. Lowercased
    # on the way out: the tag is matched case-insensitively above, and the
    # whitelist on the other side of the pipe has one spelling.
    for tag in tags:
        print(f"<<{tag.lower()}>>", flush=True)
    if text:
        print(text, flush=True)


def drain(force=False):
    global buf
    while True:
        m = BOUNDARY.search(buf)
        if not m:
            break
        emit(buf[:m.end()])
        buf = buf[m.end():]
    if force:
        emit(buf)
        buf = ""


def consume():
    global buf, full, turn, got_delta, status
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        kind = ev.get("type")
        if kind == "stream_event":
            event = ev.get("event", {})
            if event.get("type") == "content_block_start":
                # A new text block after a tool call: the previous sentence
                # ended without trailing whitespace, keep the words apart.
                if event.get("content_block", {}).get("type") == "text":
                    separate()
                    turn = ""
            elif event.get("type") == "content_block_stop":
                # The block is complete, so its last sentence is too — and
                # a sentence needs no trailing space to be one. Without this
                # « Un instant. » said before a tool call sat in the buffer
                # until the NEXT text block opened, i.e. after the tool had
                # run: the narration meant to cover the wait arrived once the
                # wait was over.
                drain(force=True)
            delta = event.get("delta", {})
            if delta.get("type") == "text_delta":
                got_delta = True
                buf += delta.get("text", "")
                full += delta.get("text", "")
                turn += delta.get("text", "")
                drain()
        elif kind == "assistant":
            for block in ev.get("message", {}).get("content", []):
                btype = block.get("type")
                if btype == "text" and not got_delta:
                    if not full and LIMIT.search(block["text"]):
                        # The CLI's usage notice arrives as a synthetic
                        # assistant message: a report on the brain, not a
                        # reply — the FSM reads it from the sidecar.
                        error(block["text"])
                        continue
                    separate()
                    buf += block["text"]
                    full += block["text"]
                    turn = block["text"]
                elif btype == "tool_use":
                    desc = describe_tool(block)
                    tool_names[block.get("id")] = desc
                    trace(f"→ {desc}")
            if not got_delta:
                drain()
        elif kind == "user":
            content = ev.get("message", {}).get("content", [])
            if isinstance(content, list):
                for block in content:
                    if block.get("type") != "tool_result":
                        continue
                    desc = tool_names.get(block.get("tool_use_id"), "?")
                    body = block.get("content")
                    if isinstance(body, list):
                        body = " ".join(b.get("text", "")
                                        for b in body if isinstance(b, dict))
                    mark = "✗" if block.get("is_error") else "←"
                    trace(f"{mark} [{desc.split(':')[0]}] {squash(body)}")
        elif kind == "result":
            # A denied tool is silent otherwise: the user hears « je n'ai pas
            # pu » and the dreams — which read FAILURES.md, not the trace —
            # never learn a missing allowlist row was the cause. The CLI
            # publishes the refusals itself in the result event, so this
            # reads them rather than hunting « permission » in the text of
            # failed tools: an ordinary `Permission denied` from a directory
            # the brain was allowed to read would otherwise be filed as a
            # gap in the allowlist, and three such notes arm a dream that
            # rewrites LEARNED.md. First refusal wins.
            for d in (ev.get("permission_denials") or [])[:1]:
                with open(out_path + ".denied", "w") as f:
                    f.write(describe_tool({"name": d.get("tool_name"),
                                           "input": d.get("tool_input")}))
            failed = ev.get("is_error") or ev.get("subtype", "") != "success"
            if failed:
                # Whatever text came before it: a session that ends in error
                # has reported on itself, and the FSM must hear that even
                # when a partial answer was already spoken.
                error(ev.get("result") or ev.get("subtype") or "erreur de session")
            else:
                status = "ok"
                if not full:
                    buf = ev.get("result") or ""
                    full = buf
                    turn = buf
    drain(force=True)


# A barge-in closes the voice's end of the pipe under us. Dying silently
# there wrote nothing at all to <reply-file>, which the FSM read as a brain
# that had answered nothing — and sent it off to ask the same question a
# second time and speak an answer the user had just cancelled. So the
# partial reply is written whatever happens, and the interruption is
# recorded as itself rather than as emptiness.
interrupted = False
try:
    consume()
except (BrokenPipeError, KeyboardInterrupt):
    interrupted = True
finally:
    try:
        # The voice spoke everything, so the journal gets everything. A
        # quiet caller wants the report: the last block, or all of it when
        # the last block is empty (a session that ended on a tool call).
        with open(out_path, "w") as f:
            # The bubble and the journal read this file: a literal
            # "<<proud>>" showing up there is a bug, not an emote.
            report = (turn or full) if quiet else full
            f.write(" ".join(EMOTE_TAG.sub("", report).split()))
        if status:
            with open(out_path + ".status", "w") as f:
                f.write(status)
        if interrupted:
            with open(out_path + ".interrupted", "w") as f:
                f.write("1")
            trace("✗ flux interrompu")
    except OSError:
        pass
    # Python flushes stdout at shutdown; on a closed pipe that prints an
    # "Exception ignored" traceback into $LOG for no one's benefit.
    try:
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
