#!/usr/bin/env python3
"""jarvis-sentences — turn a claude stream into speakable sentences,
and trace everything the brain does along the way.

Reads `claude -p --output-format stream-json --include-partial-messages`
on stdin and emits one complete sentence per line, unbuffered, as soon as
each boundary arrives — so the voice can start on sentence one while the
brain still writes sentence two. The full reply is written to argv[1]
when the stream ends — and also when it does not: a reader that walks away
mid-stream (a barge-in) gets whatever had arrived, plus an
<reply-file>.interrupted marker, rather than an empty file the pipeline
would read as a brain that answered nothing.

Usage: jarvis-sentences [--quiet] <reply-file>
  --quiet   no sentence output (dreams, heartbeats, missions: the caller
            only wants the full text and the trace).

The black box: every tool call the brain makes (and its outcome) is
appended to memory/trace/YYYY-MM-DD.log — one compact line per event.
That file is how Jarvis can answer "pourquoi as-tu fait ça ?" and how his
dreams find the root cause behind a noted failure.

Thinking deltas are ignored; text from intermediate assistant turns (the
words spoken before a tool runs) flows through like any other — Jarvis
narrating what he's doing mid-action is a feature.
"""

import json
import os
import re
import sys
import time

args = sys.argv[1:]
quiet = "--quiet" in args
out_path = [a for a in args if not a.startswith("--")][0]

JARVIS_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
# JARVIS_MEMORY relocates the whole memory, exactly as it does for the FSM
# and for jarvis-index: without it the test suite kept appending imaginary
# quota notices and API errors to the real black box, and Jarvis's dreams
# read them as evidence.
MEMORY = os.environ.get("JARVIS_MEMORY") or os.path.join(JARVIS_DIR, "memory")
TRACE_DIR = os.path.join(MEMORY, "trace")
TRACE = os.path.join(TRACE_DIR, time.strftime("%Y-%m-%d") + ".log")

# A sentence ends at . ! ? … or : (optionally inside quotes/brackets)
# followed by whitespace. Newlines count as whitespace; markdown never
# reaches the voice anyway (the soul forbids it).
BOUNDARY = re.compile(r'[.!?…:]["»)\]]?[ \t]*\n|[.!?…]["»)\]]?[ \t]+')

# The soul forbids markdown and the brain writes it anyway on anything
# list-shaped (« 1. **work-cd** », 2026-09-02). espeak swallows most of
# it — underscores, backticks, bullets, a leading # — but reads every
# asterisk out loud, « astérisque astérisque work-cd astérisque
# astérisque », and a ~~ as « tilde tilde ». Those two stop here.
VOICED_MARKUP = re.compile(r"\*+|~~")

# The CLI reporting on itself rather than answering — a usage limit.
LIMIT = re.compile(r"(hit|reached) your .*limit|usage limit|rate limit", re.I)

buf = ""
full = ""
got_delta = False
tool_names = {}                 # tool_use_id -> "Bash: omarchy ..."


def trace(line):
    os.makedirs(TRACE_DIR, exist_ok=True)
    with open(TRACE, "a") as f:
        f.write(f"{time.strftime('%H:%M:%S')} {line}\n")


def error(text):
    """A session error is not a reply: it goes to <reply-file>.error for
    the FSM to classify (quota, lost session…) and never to the voice."""
    trace(f"✗ session: {squash(text)}")
    with open(out_path + ".error", "w") as f:
        f.write(" ".join(str(text).split()))


def squash(value, limit=200):
    text = " ".join(str(value).split())
    return text[:limit] + "…" if len(text) > limit else text


def describe_tool(block):
    name = block.get("name", "?")
    inp = block.get("input", {}) or {}
    if name == "Bash":
        detail = inp.get("command", "")
    elif name in ("Read", "Edit", "Write"):
        detail = inp.get("file_path", "")
    elif name == "WebSearch":
        detail = inp.get("query", "")
    else:
        detail = json.dumps(inp, ensure_ascii=False)
    return f"{name}: {squash(detail)}"


def separate():
    """Text blocks arrive back to back ("Un instant.RAS"): insert a
    space between two blocks when the first ends mid-line."""
    global buf, full
    if full and not full[-1].isspace():
        buf += " "
        full += " "


def emit(text):
    text = " ".join(VOICED_MARKUP.sub("", text).split())
    if text and not quiet:
        print(text, flush=True)


def drain(force=False):
    global buf
    while True:
        m = BOUNDARY.search(buf)
        if not m:
            break
        emit(buf[:m.end()])
        buf = buf[m.end():]
    if force:
        emit(buf)
        buf = ""


def consume():
    global buf, full, got_delta
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        kind = ev.get("type")
        if kind == "stream_event":
            event = ev.get("event", {})
            if event.get("type") == "content_block_start":
                # A new text block after a tool call: the previous sentence
                # ended without trailing whitespace, keep the words apart.
                if event.get("content_block", {}).get("type") == "text":
                    separate()
            delta = event.get("delta", {})
            if delta.get("type") == "text_delta":
                got_delta = True
                buf += delta.get("text", "")
                full += delta.get("text", "")
                drain()
        elif kind == "assistant":
            for block in ev.get("message", {}).get("content", []):
                btype = block.get("type")
                if btype == "text" and not got_delta:
                    if not full and LIMIT.search(block["text"]):
                        # The CLI's usage notice arrives as a synthetic
                        # assistant message: a report on the brain, not a
                        # reply — the FSM reads it from the sidecar.
                        error(block["text"])
                        continue
                    separate()
                    buf += block["text"]
                    full += block["text"]
                elif btype == "tool_use":
                    desc = describe_tool(block)
                    tool_names[block.get("id")] = desc
                    trace(f"→ {desc}")
            if not got_delta:
                drain()
        elif kind == "user":
            content = ev.get("message", {}).get("content", [])
            if isinstance(content, list):
                for block in content:
                    if block.get("type") != "tool_result":
                        continue
                    desc = tool_names.get(block.get("tool_use_id"), "?")
                    body = block.get("content")
                    if isinstance(body, list):
                        body = " ".join(b.get("text", "")
                                        for b in body if isinstance(b, dict))
                    mark = "✗" if block.get("is_error") else "←"
                    trace(f"{mark} [{desc.split(':')[0]}] {squash(body)}")
        elif kind == "result":
            failed = ev.get("is_error") or ev.get("subtype", "") != "success"
            if failed and not full:
                error(ev.get("result") or ev.get("subtype") or "erreur de session")
            elif failed:
                trace(f"✗ session: {squash(ev.get('result') or ev.get('subtype'))}")
            elif not full:
                buf = ev.get("result") or ""
                full = buf
    drain(force=True)


# A barge-in closes the voice's end of the pipe under us. Dying silently
# there wrote nothing at all to <reply-file>, which the FSM read as a brain
# that had answered nothing — and sent it off to ask the same question a
# second time and speak an answer the user had just cancelled. So the
# partial reply is written whatever happens, and the interruption is
# recorded as itself rather than as emptiness.
interrupted = False
try:
    consume()
except (BrokenPipeError, KeyboardInterrupt):
    interrupted = True
finally:
    try:
        with open(out_path, "w") as f:
            f.write(" ".join(full.split()))
        if interrupted:
            with open(out_path + ".interrupted", "w") as f:
                f.write("1")
            trace("✗ flux interrompu")
    except OSError:
        pass
    # Python flushes stdout at shutdown; on a closed pipe that prints an
    # "Exception ignored" traceback into $LOG for no one's benefit.
    try:
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
