#!/usr/bin/env bash
# omarchy-jarvis — the voice of this machine.
#
# An explicit state machine. Its table — the eight states, the nine events,
# every legal couple and what each one means — lives in bin/jarvis-fsm.sh,
# written out in prose above the code and frozen into
# tests/fixtures/transitions.txt so it cannot drift. This file is the body
# around it: the organs, the verbs, and what each stage does while it holds
# the machine.
#
# Long stages (transcribe, brain, speak) run inside the invocation that
# entered them; a concurrent invocation only touches the state record and
# the process groups on disk, so a press while speaking can barge in safely
# — and the barged-in invocation, whose epoch has moved on, goes quiet
# instead of finishing a job nobody wants any more. The mascot
# (macarchy.jarvis shell plugin) mirrors every state over IPC.
#
#   jarvis press          the one button: advance the machine, or abort it
#   jarvis cancel         back to idle, discard everything in flight
#   jarvis watchdog       the pulse's first move: free a stage that wedged
#   jarvis reset          forget the conversation (new soul applies here)
#   jarvis ask "text"     text in, spoken reply out (--quiet: no voice)
#   jarvis say "text"     just speak
#   jarvis state          print the current state
#   jarvis status         key=value report for the Control Center
#   jarvis suggestions    the dreams' proposals; `suggestion <n> accept|reject`
#   jarvis digest         turn ~/Jarvis/input drops into memory fiches
#   jarvis doctor         deterministic self-check of every dependency
#   jarvis rotate         summarize and close a stale conversation
#   jarvis look [random]  regenerate the mascot from the soul's look settings
#   jarvis lastcmd/missed his senses: the last shell command, missed notifications
#   jarvis save           « enregistre ça » — the clipboard into ~/Jarvis/input
#   jarvis greet          the unlock hello: a bubble with what happened meanwhile
#
# The persona is CLAUDE.md (operational) + SOUL.md (identity, editable from
# the Control Center); both live next to this script's parent directory.

set -uo pipefail

JARVIS_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# JARVIS_RUN/STATE/MEMORY override the real locations — that is what
# lets tests/run exercise the whole pipeline in a sandbox.
RUN_DIR="${JARVIS_RUN:-${XDG_RUNTIME_DIR:-/tmp}/jarvis}"
STATE_DIR="${JARVIS_STATE:-$HOME/.local/state/jarvis}"
LOG="$STATE_DIR/jarvis.log"
WAV="$RUN_DIR/utterance.wav"
STATE_FILE="$RUN_DIR/state"
CONV_FLAG="$STATE_DIR/conversation"
LAST_ASK="$RUN_DIR/last-ask"
MEMORY_DIR="${JARVIS_MEMORY:-$JARVIS_DIR/memory}"
# The soul lives in the repository rather than in a sandbox, because it is
# edited by hand and by the Control Center. JARVIS_SOUL moves it anyway, for
# the same reason as every other override here: a setting that changes what
# the pipeline DOES is a setting the test suite has to be able to vary.
SOUL_FILE="${JARVIS_SOUL:-$JARVIS_DIR/SOUL.md}"
FAILURES="$MEMORY_DIR/FAILURES.md"
SUGGESTIONS="$MEMORY_DIR/SUGGESTIONS.md"
LAST_REPLY="$RUN_DIR/last-reply"
# One line: `ok`, `quota <until-epoch>`, `blocked` or `down` — what the
# last answer from the brain told us about the brain itself.
BRAIN_STATUS="$STATE_DIR/brain"
# The exchange box: the file contract between the user and Jarvis —
# drop a document in input/, it becomes memory; todo/TODO.md is edited
# by voice; output/ receives requested extractions. JARVIS_BOX overrides
# for tests.
BOX_DIR="${JARVIS_BOX:-$HOME/Jarvis}"
# Where `look` writes the mascot's sprite sheets. NOT inside the plugin
# directory: the shell watches its plugin folders and hot-reloads the
# whole shell on any change there — which closed the Control Center on
# every appearance click. The plugin reads from here.
SPRITES_DIR="${JARVIS_SPRITES:-$HOME/.local/share/jarvis/sprites}"

# The two organs of the voice path. They are named, not hardcoded, for the
# same reason as the directories above: an absolute path to a binary that
# only exists on this machine is a path the test suite cannot walk, and
# everything downstream of it — recording, transcription, speaking — went
# untested because of it. JARVIS_PIPER/JARVIS_VOXTYPE swap in the fakes.
PIPER="${JARVIS_PIPER:-$JARVIS_DIR/piper/piper}"
VOXTYPE="${JARVIS_VOXTYPE:-voxtype}"
VOICE_EN="$JARVIS_DIR/models/en_GB-alan-medium.onnx"
STT_CONFIG="$JARVIS_DIR/voxtype.toml"
REPLY_TXT="$RUN_DIR/reply.txt"
# The internal microphone, via asahi-audio's effect chain. The system
# default source has been seen wandering off to the FaceTime camera, so
# recording always targets this node when it exists.
MIC_TARGET="${JARVIS_MIC:-effect_output.j493-mic}"
# The abort journal. Deliberately NOT FAILURES.md: see note_abort.
ABORTS="$MEMORY_DIR/ABORTS.md"

mkdir -p "$RUN_DIR" "$STATE_DIR" "$HOME/.cache/jarvis"

# The state machine proper: the transition table, the ownership record
# (claim/mine) and the process groups (group_run/kill_group). Everything
# below is written against it. Read that file first — it is where the
# machine is described.
# shellcheck source=bin/jarvis-fsm.sh
. "$JARVIS_DIR/bin/jarvis-fsm.sh"

# ---------------------------------------------------------- the deadlines
#
# How long the machine may stay in each state before `watchdog` decides that
# nobody is coming back. Every number below is a measured worst case with
# room to spare, not a guess, and every one is overridable — that is what
# lets the suite make a wedge happen in a tenth of a second instead of three
# minutes:
#
#   transcribing   60 s   whisper on the longest utterance the wake daemon
#                         allows (a 20 s window) runs in about eight seconds
#                         here; a minute means voxtype is not coming back
#   thinking      180 s   a sonnet answer with three tool calls has been
#                         timed at seventy seconds. Past three minutes the
#                         network is gone, not slow — and the grace
#                         extension below covers a brain that is visibly
#                         still working
#   speaking      300 s   the longest reply ever spoken on this machine was
#                         forty seconds of audio, and synthesis happens
#                         sentence by sentence inside this same state
#   listening      90 s   the daemon caps a listening window at twenty
#                         seconds. Ninety means there is no daemon and the
#                         user walked away with the microphone open
#   followup        8 s   the daemon's own window is six seconds; this is
#                         the same exit two seconds later, for when the
#                         daemon is dead — which is exactly how the follow-up
#                         window used to stay open until logout
#   sleeping      600 s   a dream reads the whole failure journal and
#                         rewrites three files
#   cancelling      5 s   five kills and one file removed. If THAT hangs,
#                         the machine is in worse shape than the request the
#                         abort was serving
deadline_for() {
	case "$1" in
	listening) echo "${JARVIS_DEADLINE_LISTENING:-90}" ;;
	transcribing) echo "${JARVIS_DEADLINE_TRANSCRIBING:-60}" ;;
	thinking) echo "${JARVIS_DEADLINE_THINKING:-180}" ;;
	speaking) echo "${JARVIS_DEADLINE_SPEAKING:-300}" ;;
	followup) echo "${JARVIS_DEADLINE_FOLLOWUP:-8}" ;;
	sleeping) echo "${JARVIS_DEADLINE_SLEEPING:-600}" ;;
	cancelling) echo "${JARVIS_DEADLINE_CANCELLING:-5}" ;;
	*) echo 0 ;;
	esac
}

# And how long it has been there, in seconds: the watchdog's clock, and the
# doctor's. The record is the truth. A mirror with no record beside it — an
# upgrade that landed mid-conversation, a state file left by a session that
# never came back — is dated by its own mtime, which is exactly the case that
# most deserves a watchdog.
state_age() {
	local now
	rec_read
	if ((REC_SINCE > 0)); then
		echo $((($(date +%s%3N) - REC_SINCE) / 1000))
	else
		now=$(date +%s)
		echo $((now - $(stat -c %Y "$STATE_FILE" 2>/dev/null || echo "$now")))
	fi
}

# The written exchange (`ask --quiet`): everything happens — brain,
# bubble, notification, journal, Control Center banner — except the
# speakers. For shared offices.
QUIET=0

log() { printf '%s %s\n' "$(date +%FT%T)" "$*" >>"$LOG"; }

notify() { notify-send -a "Jarvis" -t 5000 "$1" "${2-}" 2>/dev/null || true; }

# Animate the Babel fish; harmless when the shell or plugin is not running.
mascot() { omarchy-shell macarchy.jarvis "$@" >/dev/null 2>&1 || true; }

# Everything the body says about the CURRENT exchange goes through mascot()
# directly. Everything else — an emotion Jarvis chose to punctuate a reply
# with, a mission report, a dream's summary, the unlock hello — is an aside,
# and an aside sent while he is working is worse than no aside at all: the
# pipeline's own sprite always wins, so `emote proud` fired mid-answer was
# never once seen on screen, and a mission report dropped into the bubble
# mid-reply wiped the text being typed out and made the typewriter restart
# from the first character. So an aside waits its turn: parked in
# $STATE_DIR while he is busy, played by the way back to rest.
mascot_emote() {
	if [[ $(state) == idle ]]; then
		mascot emote "$1"
	else
		printf '%s' "$1" >"$STATE_DIR/emote-pending"
	fi
}

mascot_aside() {
	if [[ $(state) == idle ]]; then
		mascot reply "$1"
	else
		printf '%s' "$1" >"$STATE_DIR/aside-pending"
	fi
}

# Flushed by on_state_change on the way to idle. Five minutes late is not an
# emotion any more, it is a ghost: a worried fish about a mission that ended
# half an hour ago says nothing true.
mascot_flush() {
	local kind file text
	for kind in emote aside; do
		file="$STATE_DIR/$kind-pending"
		[[ -e $file ]] || continue
		text=$(cat "$file" 2>/dev/null)
		if [[ -n $text && -n $(find "$file" -mmin -5 2>/dev/null) ]]; then
			case "$kind" in
			emote) mascot emote "$text" ;;
			aside) mascot reply "$text" ;;
			esac
		fi
		rm -f "$file"
	done
}

# The black box: one compact line per event in memory/trace/YYYY-MM-DD.log.
# The FSM writes the anchors (ask, reply, failures, missions); the stream
# parser (bin/jarvis-sentences) writes every tool call the brain makes in
# between. This is what Jarvis reads to debug his own behavior.
trace() {
	mkdir -p "$MEMORY_DIR/trace"
	printf '%s %s\n' "$(date +%H:%M:%S)" "$1" >>"$MEMORY_DIR/trace/$(date +%F).log"
}

# Append one failure line to the memory journal. Jarvis calls this himself
# (allowlisted) when he cannot satisfy a request; the pipeline calls it for
# mechanical failures (empty transcript, unreachable brain, barge-in).
note_failure() {
	mkdir -p "$MEMORY_DIR"
	printf -- '- [%s] %s\n' "$(date +%FT%H:%M)" "$1" >>"$FAILURES"
	log "note: $1"
	trace "✗ échec noté : $1"
}

# A state, said the way a French sentence needs it: « figé pendant sa
# réflexion », « annulé pendant la transcription ». One table for both,
# because the watchdog's notification and the abort journal want the same
# words about the same moment.
stage_fr() {
	case "$1" in
	listening) echo "son écoute" ;;
	transcribing) echo "la transcription" ;;
	thinking) echo "sa réflexion" ;;
	speaking) echo "sa réponse" ;;
	followup) echo "sa fenêtre de relance" ;;
	sleeping) echo "son rêve" ;;
	cancelling) echo "son annulation" ;;
	*) echo "son repos" ;;
	esac
}

# An abort is not a failure, and this is the whole reason it gets a journal
# of its own. Interrupting a request you no longer want is the system doing
# its job — but every barge-in used to land in FAILURES.md, and ONE line
# there is enough for maybe-dream to schedule a sonnet consolidation whose
# job is to distil lessons into LEARNED.md, which CLAUDE.md then imports as
# persona. Pressing a key to stop an answer therefore manufactured permanent
# changes to who Jarvis is. Here instead: the stage, how long it had been
# running and what asked for the abort, so a dream can recognise a REPEATED
# pattern (« il coupe toujours pendant la transcription ») and ignore the
# rest. Under two seconds nothing is recorded at all: that is not a pattern,
# it is a fumbled press.
note_abort() {
	local stage="$1" ms="${2:-0}" trigger="${3:-commande}" secs
	[[ $ms =~ ^[0-9]+$ ]] || ms=0
	((ms >= 2000)) || return 0
	secs=$((ms / 1000))
	mkdir -p "$MEMORY_DIR"
	[[ -e $ABORTS ]] || printf '# ABORTS.md — journal des annulations\n\n' >"$ABORTS"
	printf -- '- [%s] annulé pendant %s après %s s (%s)\n' \
		"$(date +%FT%H:%M)" "$(stage_fr "$stage")" "$secs" "$trigger" >>"$ABORTS"
	log "abort: $stage after ${secs}s ($trigger)"
	trace "— annulé pendant $(stage_fr "$stage") après $secs s ($trigger) —"
}

# One dated line into today's journal (memory/journal/YYYY-MM-DD.md):
# exchanges, dreams, heartbeat findings. The journal is what "qu'est-ce
# qui s'est passé aujourd'hui ?" reads, and dreams use it for context.
journal() {
	local day file
	day=$(date +%F)
	file="$MEMORY_DIR/journal/$day.md"
	mkdir -p "$MEMORY_DIR/journal"
	[[ -e $file ]] || printf '# Journal — %s\n\n' "$day" >"$file"
	printf -- '- %s %s\n' "$(date +%H:%M)" "$1" >>"$file"
}

# ----------------------------------------------------------- the settings

# One soul setting (`- key: value` under « Réglages » in SOUL.md), or the
# default when the line is missing. The Control Center writes these lines.
setting() {
	local v
	v=$(grep -m1 "^- $1:" "$SOUL_FILE" 2>/dev/null | sed "s/^- $1: *//; s/ *$//")
	printf '%s' "${v:-$2}"
}

# The five settings the fish is assembled from, on one line. `look` stamps
# this beside the generated sheets and doctor compares the two: a colour
# changed from the Control Center whose regeneration then failed is otherwise
# completely invisible — the old fish keeps swimming and nothing says why.
look_signature() {
	printf '%s %s %s %s %s\n' "$(setting corps B1)" "$(setting oeil E1)" \
		"$(setting criniere M1)" "$(setting queue T1)" "$(setting couleur or)"
}

# Write one soul setting (the Control Center does the same with sed).
set_setting() {
	local soul="$SOUL_FILE"
	if grep -q "^- $1:" "$soul"; then
		sed -i "s/^- $1: .*/- $1: $2/" "$soul"
	else
		sed -i "/^- langue:/a - $1: $2" "$soul"
	fi
}

# The quiet hours (`silence: 23-7`, or `non`): no rounds, no dreams, no
# unsolicited voice. What the user asks for is never affected.
quiet_now() {
	local win start end h
	win=$(setting silence 23-7)
	[[ $win =~ ^([0-9]{1,2})-([0-9]{1,2})$ ]] || return 1
	start=${BASH_REMATCH[1]} end=${BASH_REMATCH[2]} h=$(date +%-H)
	if ((start <= end)); then
		((h >= start && h < end))
	else
		((h >= start || h < end))
	fi
}

# --------------------------------------------------------- brain health

brain_status() { cat "$BRAIN_STATUS" 2>/dev/null || echo ok; }

# Record a status and, when it actually changes, say so once — in French,
# in the journal and a notification, never through the voice.
brain_set() {
	local prev now="$1" msg=""
	prev=$(brain_status)
	printf '%s' "$now" >"$BRAIN_STATUS"
	[[ ${prev%% *} == "${now%% *}" ]] && return 0
	case "$now" in
	quota\ *) msg="cerveau : quota atteint, retour vers $(date -d "@${now#quota }" +%H:%M)" ;;
	blocked) msg="cerveau : ronde bloquée sur une approbation" ;;
	down) msg="cerveau : injoignable" ;;
	ok) msg="cerveau : de retour" ;;
	esac
	log "brain: $now"
	trace "$([[ $now == ok ]] && echo ✓ || echo ✗) $msg"
	journal "$msg"
	if [[ $now == ok ]]; then
		mascot_emote celebrate
	else
		mascot_emote worried
		notify "Jarvis" "$msg"
	fi
}

# Classify what came back from the brain. Returns 0 when it is a real
# answer (and records `ok`), 1 when it is the brain reporting on itself:
# a usage limit (with the reset hour when it says one), an empty answer,
# or — for rounds only — a stall on a permission prompt.
brain_check() {
	local text="$1" kind="${2:-}" until
	if [[ -z ${text// /} ]]; then
		brain_set down
		return 1
	fi
	if [[ $text =~ (hit|reached)\ your\ .*limit|[Uu]sage\ limit|[Rr]ate\ limit ]]; then
		until=""
		if [[ $text =~ resets\ ([0-9]{1,2}(:[0-9]{2})?\ ?[ap]m) ]]; then
			until=$(date -d "${BASH_REMATCH[1]}" +%s 2>/dev/null)
			[[ -n $until ]] && ((until <= $(date +%s))) && until=$((until + 86400))
		fi
		brain_set "quota ${until:-$(($(date +%s) + 3600))}"
		return 1
	fi
	if [[ $kind == ronde && $text =~ approbation|approuv|autorisation|permission ]]; then
		brain_set blocked
		return 1
	fi
	brain_set ok
}

# What Jarvis says out loud instead of a broken answer.
brain_excuse() {
	case "$(brain_status)" in
	quota\ *) echo "Mon cerveau a atteint son quota. Retour vers $(date -d "@$(brain_status | cut -d' ' -f2)" +%-H) heures." ;;
	*) echo "Je n'ai pas pu joindre mon cerveau. Voyez le journal." ;;
	esac
}

# Idempotent scaffold for his memory. The five journals below are runtime
# state — what he failed at HERE, what you interrupted, what he learned about
# YOU — so they are not tracked; memory/scaffold/ holds their headers, which
# are, because a header says who writes a file and in what shape. A fresh
# clone restores them on its first command, and so does a machine where one
# was deleted. CLAUDE.md imports two of them, so an absent file is not a
# cosmetic problem: it is the persona arriving incomplete.
memory_init() {
	local f name
	for f in "$JARVIS_DIR/memory/scaffold"/*.md; do
		[[ -e $f ]] || continue
		name=$(basename "$f")
		[[ -e $MEMORY_DIR/$name ]] || cp "$f" "$MEMORY_DIR/$name"
	done
}

# Idempotent scaffold for ~/Jarvis. The hidden dirs under input/ are the
# digestion machinery: .work (claimed), .pending (waiting on the brain),
# .archive (digested originals), .failed (given up). memory is a symlink
# so everything of Jarvis lives in one place.
box_init() {
	mkdir -p "$BOX_DIR/input/.work" "$BOX_DIR/input/.pending" \
		"$BOX_DIR/input/.archive" "$BOX_DIR/input/.failed" \
		"$BOX_DIR/todo" "$BOX_DIR/output"
	[[ -e $BOX_DIR/memory ]] || ln -s "$MEMORY_DIR" "$BOX_DIR/memory"
	[[ -e $BOX_DIR/todo/TODO.md ]] || printf '# TODO\n\n' >"$BOX_DIR/todo/TODO.md"
}

# ------------------------------------------------------------ the machine

# The body's half of a transition. bin/jarvis-fsm.sh knows nothing of fish,
# Touch Bars or quiet hours; it writes the record, releases its lock, and
# then calls this — so none of what follows can ever be holding the lock
# while it waits on the shell's IPC.
on_state_change() {
	local sprite=$1 pid
	# The mascot has no transcribing or followup sprite; it ponders through
	# the one and stays perked up through the other. `cancelling` sends
	# nothing at all: the abort has an animation of its own (`mascot abort`,
	# fired by do_cancel), and a setState landing on top of it would trade
	# the one gesture that says « I heard you » for a sprite that would be
	# on screen for a few hundred milliseconds.
	[[ $1 == transcribing ]] && sprite=thinking
	[[ $1 == followup ]] && sprite=listening
	[[ $1 == cancelling ]] || mascot setState "$sprite"
	# The Touch Bar key wears the state too (omarchy-dfr renders it on USR1).
	# JARVIS_NO_DESKTOP keeps the suite's hundreds of transitions off the
	# real Touch Bar: that daemon lives outside every sandbox.
	if [[ -z ${JARVIS_NO_DESKTOP:-} ]]; then
		pid=$(cat "${XDG_RUNTIME_DIR:-/tmp}/omarchy-dfr/daemon.pid" 2>/dev/null) && kill -USR1 "$pid" 2>/dev/null
	fi
	# One truth about the quiet hours, and it is this one: the mascot used to
	# hardcode its own 23-7 night and curled up asleep whatever the soul said.
	printf '%s' "$(quiet_now && echo 1 || echo 0)" >"$STATE_DIR/quiet"
	[[ $1 == idle ]] && mascot_flush
	return 0
}

# The follow-up window only makes sense if the wake daemon is there to
# watch it (it detects the speech onset and settles the timeout).
#
# The launcher (bin/jarvis-wake) holds a flock on wake.lock for the whole
# life of the daemon, so failing to take that lock IS the daemon being
# alive. `pgrep -f jarvis-wake.py` used to answer this and lied both ways:
# an editor with the file open, or this very grep, counted as a daemon.
# JARVIS_WAKE=0|1 answers for the tests, which have no daemon at all.
wake_alive() {
	case "${JARVIS_WAKE:-}" in
	1) return 0 ;;
	0) return 1 ;;
	esac
	[[ -e $RUN_DIR/wake.lock ]] || return 1
	! flock -n "$RUN_DIR/wake.lock" true 2>/dev/null
}

# Which brain answers: a plain command goes to haiku, an open question —
# long, interrogative, or explicitly reflective — escalates to sonnet.
# JARVIS_MODEL overrides both.
pick_model() {
	if [[ -n ${JARVIS_MODEL:-} ]]; then
		echo "$JARVIS_MODEL"
		return
	fi
	local text=${1,,} words
	local re='pourquoi|comment|explique|analyse|compare|résume|raconte|propose|conseille|réfléchis|penses|why|how|explain|analy[sz]e|summari[sz]e|suggest|think'
	words=$(wc -w <<<"$text")
	if ((words > 14)) || [[ $text =~ $re ]]; then
		echo sonnet
	else
		echo haiku
	fi
}

# ------------------------------------------------------------- the organs

# Which French voice speaks. His voice is as much who he is as his tone or
# his fish, so the soul chooses it — and the three models do not share a
# licence, which decides the default: siwis is CC-BY 4.0, upmc CC-BY-SA 4.0,
# and tom is AGPL-3.0. Nobody should have to reason about copyleft to install
# a voice assistant, so tom is a deliberate choice rather than what you get by
# not choosing. Read fresh every time, like `langue`: a change from the
# Control Center applies to the next sentence, not the next reboot.
voice_fr() {
	local name
	name=$(setting voix siwis)
	case "$name" in
	siwis | tom | upmc) ;;
	*) name=siwis ;;
	esac
	printf '%s' "$JARVIS_DIR/models/fr_FR-$name-medium.onnx"
}

# Crude but effective: French replies carry accents or French function words.
voice_for() {
	local text=${1,,}
	if [[ $text == *[éèêàçùôîû]* || $text =~ (^|[[:space:]])(le|la|les|est|c\'est|voilà|activé|activée|fait|batterie|monsieur)([[:space:]]|[.,!]|$) ]]; then
		voice_fr
	else
		echo "$VOICE_EN"
	fi
}

# Where speaking lands when it ends naturally: the follow-up window (the
# wake daemon listens a few seconds for a rejoinder, no wake word needed)
# after a real exchange, plain idle otherwise or when nobody is watching.
after_speaking() {
	if [[ ${1:-} == followup ]] && wake_alive; then
		transition done
	else
		transition rest
	fi
}

# Speak, interruptibly: the player runs in a group of its own, so a barge-in
# press from another invocation can reach it. Every step is behind `mine` —
# synthesis takes seconds, and an answer the user cancelled halfway through
# must not take the speakers back when its wav is finally ready.
do_speak() {
	local text="$1" follow="${2:-}" wav="$RUN_DIR/reply.wav"
	[[ -n $text ]] || return 0
	mine || return 0
	if ((QUIET)); then
		case "$(state)" in thinking | speaking) transition rest ;; esac
		return 0
	fi
	if ! printf '%s' "$text" | group_run voice "$PIPER" --model "$(voice_for "$text")" --output_file "$wav" 2>>"$LOG"; then
		# Being cut off mid-synthesis is not a failure of the voice.
		mine || return 0
		note_failure "voix : synthèse impossible pour « $text »"
		return 1
	fi
	mine || return 0
	transition speak || return 1
	group_run play pw-play "$wav" 2>>"$LOG"
	mine || return 0
	[[ $(state) == speaking ]] && after_speaking "$follow"
	return 0
}

# Speak a stream: one sentence per stdin line, synthesized and played as
# they arrive — the voice starts on sentence one while the brain still
# writes the rest. The bubble grows sentence by sentence. A barge-in (the
# state moved off speaking) drops whatever is still in the pipe.
speak_sentences() {
	local sentence wav tried=0 spoken=0 acc=""
	if ((QUIET)); then
		while IFS= read -r sentence; do
			[[ -n ${sentence// /} ]] || continue
			mine || return 0
			acc+="${acc:+ }$sentence"
			mascot reply "$acc"
			tried=$((tried + 1))
		done
		((tried > 0)) && [[ $(state) == thinking ]] && transition rest
		return 0
	fi
	while IFS= read -r sentence; do
		[[ -n ${sentence// /} ]] || continue
		mine || return 0
		if ((tried == 0)); then
			[[ $(state) == thinking ]] || break
			transition speak || break
		elif [[ $(state) != speaking ]]; then
			break
		fi
		# Attempts and successes are two different counts. Conflating them is
		# what left him frozen mid-answer: the sentence that failed to
		# synthesize never incremented anything, so the closing transition,
		# hidden behind that same count, never ran either.
		tried=$((tried + 1))
		acc+="${acc:+ }$sentence"
		mascot reply "$acc"
		wav="$RUN_DIR/reply-$((tried % 2)).wav"
		if ! printf '%s' "$sentence" | group_run voice "$PIPER" --model "$(voice_for "$sentence")" --output_file "$wav" 2>>"$LOG"; then
			mine || return 0
			# A dropped sentence is not a skip: the answer he speaks would be
			# missing a clause the bubble still shows, and half an answer can
			# mean the opposite of the whole one. Stop and let him be read.
			note_failure "voix : synthèse impossible pour « $sentence »"
			break
		fi
		mine || return 0
		[[ $(state) == speaking ]] || break
		group_run play pw-play "$wav" 2>>"$LOG"
		spoken=$((spoken + 1))
	done
	# Coming down matters more than where to: if the state is still ours,
	# a voice that got out earns the follow-up window, while one that never
	# did (piper failing on the first sentence) goes straight to rest rather
	# than leaving the fish stuck mid-sentence forever.
	mine || return 0
	if [[ $(state) == speaking ]]; then
		if ((spoken > 0)); then
			after_speaking followup
		else
			transition rest
		fi
	fi
}

# The conversation is ONE claude session with an id of our own, kept in
# $CONV_FLAG: rounds, dreams and missions each open their own session in
# this same directory, so `--continue` ("the most recent conversation")
# would happily resume a heartbeat instead of the user's thread. `reset`
# empties the flag so the next exchange starts fresh (that is when a new
# SOUL.md takes effect). conv_args prints the two flags (the id is the
# second); the caller commits that id once a reply actually came back.
conv_args() {
	local id
	id=$(cat "$CONV_FLAG" 2>/dev/null)
	if [[ -n $id ]]; then
		printf -- '--resume\n%s\n' "$id"
	else
		printf -- '--session-id\n%s\n' "$(cat /proc/sys/kernel/random/uuid)"
	fi
}

# One question to the brain, non-streaming (the fallback path). Its
# stdout is checked by the caller: a usage-limit notice comes back as
# plain text here.
brain() {
	local text="$1" model="${2:-haiku}" reply
	local -a args
	cd "$JARVIS_DIR" || return 1
	mapfile -t args < <(conv_args)
	reply=$(claude -p "${args[@]}" --model "$model" -- "$text" 2>>"$LOG")
	if [[ -z ${reply:-} && ${args[0]} == --resume ]]; then
		# The remembered session is gone: start over, once.
		rm -f "$CONV_FLAG"
		mapfile -t args < <(conv_args)
		reply=$(claude -p "${args[@]}" --model "$model" -- "$text" 2>>"$LOG")
	fi
	[[ -n ${reply:-} ]] && printf '%s' "${args[1]}" >"$CONV_FLAG"
	printf '%s' "${reply:-}"
}

# The streaming brain: sentences flow straight into the voice as they are
# generated. The full reply lands in $REPLY_TXT for the journal; a session
# error (usage limit, lost session) lands in $REPLY_TXT.error instead and
# never reaches the voice.
stream_brain() {
	local text="$1" model="$2"
	local -a args
	cd "$JARVIS_DIR" || return 1
	rm -f "$REPLY_TXT" "$REPLY_TXT.error" "$REPLY_TXT.interrupted"
	mapfile -t args < <(conv_args)
	# The last look before the money is spent. Everything between taking the
	# machine and this line — a bubble sent to the fish, a model chosen, a
	# session id read — is tens of milliseconds during which the group does
	# not exist yet, so an abort arriving there has nothing to kill and the
	# question would be asked anyway: paid for, answered into a void.
	mine || return 0
	group_run brain claude -p "${args[@]}" --model "$model" \
		--output-format stream-json --include-partial-messages --verbose \
		-- "$text" 2>>"$LOG" |
		"$JARVIS_DIR/bin/jarvis-sentences" "$REPLY_TXT" |
		speak_sentences
	# A barge-in closes the voice's end of the pipe, and the stream parser
	# says so instead of dying silently — which used to look exactly like a
	# brain that had answered nothing, and sent run_exchange off to ask the
	# same question a second time.
	if [[ -e $REPLY_TXT.interrupted ]]; then
		log "brain: stream interrupted"
		trace "✗ flux interrompu"
	fi
	mine || return 0
	[[ -s $REPLY_TXT ]] && printf '%s' "${args[1]}" >"$CONV_FLAG"
	return 0
}

# thinking → speaking → followup/idle, from a question. The caller owns the
# machine and has already moved it into `thinking`; every step here is behind
# `mine`, because each one of them is seconds long and the user may have said
# stop in the middle of any of them.
run_exchange() {
	local text="$1" reply model err
	mine || return 0
	log "ask: $text"
	printf '%s' "$text" >"$LAST_ASK"
	# Every ask shows in the philactère — spoken, typed from the Control
	# Center, or piped through the CLI alike.
	mascot heard "$text"
	model=$(pick_model "$text")
	log "model: $model"
	trace "ask($model) « $text »"
	stream_brain "$text" "$model"
	mine || return 0
	reply=$(cat "$REPLY_TXT" 2>/dev/null)
	if [[ -z $reply ]]; then
		# The stream produced nothing. Either the brain told us why (a
		# usage limit — no point retrying) or the remembered session is
		# stale: one fresh, non-streaming retry before declaring it down.
		# The retry keeps the session id: brain() already holds the correct
		# one-shot fallback for a session that is genuinely gone, and
		# throwing the id away here erased a whole morning's conversation
		# every time a single turn failed transiently.
		err=$(cat "$REPLY_TXT.error" 2>/dev/null)
		if [[ -n $err ]] && ! brain_check "$err"; then
			reply=""
		else
			reply=$(brain "$text" "$model")
			brain_check "$reply" || reply=""
		fi
		mine || return 0
		if [[ -z $reply ]]; then
			[[ $(brain_status) == quota* ]] || note_failure "cerveau injoignable pour : « $text »"
			reply=$(brain_excuse)
			log "reply: $reply"
			printf '%s' "$reply" >"$LAST_REPLY"
			journal "échange : « $text » → « $reply »"
			mascot reply "$reply"
			do_speak "$reply"
			return 1
		fi
		mascot reply "$reply"
		do_speak "$reply" followup
	else
		brain_set ok
	fi
	mine || return 0
	log "reply: $reply"
	printf '%s' "$reply" >"$LAST_REPLY"
	trace "reply « $reply »"
	journal "échange : « $text » → « $reply »"
	notify "$text" "$reply"
}

# Open the ear. The argument, when there is one, is a barge-in — a press
# while he is still speaking — and it is the French word that says who asked,
# exactly as `cancel --from` takes: the abort journal is read by the user and
# by the dreams, and both read French.
# Whether the node the recorder would actually read is muted. Only that node
# is asked, and that is the point: on 2026-09-01 the hardware source was wide
# open while the filter-chain output in front of it — the one $MIC_TARGET
# names, the one pw-record reads — was muted. Everything looked healthy,
# including the doctor, and nothing could hear.
mic_muted() {
	[[ $(pactl get-source-mute "$MIC_TARGET" 2>/dev/null) == *yes* ]]
}

# What he does instead of opening an ear nothing can come through, per the
# soul's `micro-coupe`:
#
#   ecrire     (default) hand over the keyboard — the written prompt bar,
#              whose Enter goes to `ask --quiet`. He cannot hear you, so he
#              offers the other way in rather than a refusal.
#   prevenir   say why, and no more.
#
# `reactiver` is handled at the call site, because it does not replace the
# ear — it opens it. He never unmutes on his own under the other two: muting
# a microphone is a deliberate gesture, and quietly undoing it is the one
# thing a voice assistant must never do.
mic_muted_fallback() {
	if [[ $(setting micro-coupe ecrire) == prevenir ]]; then
		notify "Ton micro est coupé" "Réactive-le pour me parler."
		return 0
	fi
	notify "Ton micro est coupé" "Écris-moi — Entrée pour envoyer."
	mascot prompt
}

do_listen() {
	local trigger="${1:-}" target=() was="" held=0
	# Before the machine is claimed, and that ordering IS the fix: on
	# 2026-09-01 a muted microphone still got the fish, the « J'écoute… »
	# and five seconds of recording, and whisper answered the silence with
	# subtitle credits he then said out loud. Looking like he is listening
	# while nothing can reach him is a worse defect than the hallucination
	# it feeds, and it is the one the user actually sees.
	if mic_muted; then
		if [[ $(setting micro-coupe ecrire) == reactiver ]]; then
			pactl set-source-mute "$MIC_TARGET" 0 2>/dev/null
			notify "Micro réactivé" "Je t'écoute."
		else
			# A press during a reply is still an order to stop talking,
			# muted microphone or not — so the abort runs first, in the
			# same French the abort journal is read in.
			[[ -n $trigger ]] && do_cancel --from "$trigger"
			mic_muted_fallback
			return 0
		fi
	fi
	# How long the reply had been running has to be read BEFORE the claim:
	# claiming moves `since` to now.
	if [[ -n $trigger ]]; then
		was=$(state)
		held=$(held_ms)
	fi
	# Taking the machine IS opening the ear: one gesture, one lock, so a
	# second press arriving a millisecond later finds the move already made
	# instead of bumping the epoch out from under this one.
	claim_transition listen || return 1
	# Talking over an answer is a legitimate gesture, not a defect of the
	# machine — so it goes to the abort journal and never to FAILURES.md,
	# whose entries schedule the dreams that rewrite who he is.
	[[ -n $trigger ]] && note_abort "$was" "$held" "$trigger"
	# Nothing else may be holding an organ while the ear is open: a player
	# still talking would be recorded as the user's own question, and a
	# second recorder would fight the first for the microphone and orphan it
	# — there is one pid file per group, so the first became unkillable.
	stop_everything
	pactl list sources short 2>/dev/null | grep -q "$MIC_TARGET" && target=(--target "$MIC_TARGET")
	# The ear is the one stage that is started in the background — a recorder
	# outlives the press that opened it on purpose — and that is what made it
	# the one stage an abort could miss entirely. Between taking the machine
	# and the recorder naming itself there were a `pactl` and two forks, and
	# an abort arriving anywhere in there killed a group that did not exist
	# yet: the microphone then stayed open for the rest of the session with
	# nothing on disk to reach it by. Measured at one press in two when the
	# two gestures were fired together.
	#
	# So both halves of the answer, in this order. The handle is reserved
	# first, in the foreground, so a kill arriving from here on has something
	# to aim at and waits for the id (kill_group already knows how). Then the
	# ownership is checked, so a press that has ALREADY been overruled never
	# opens a microphone at all — and hands its reservation back rather than
	# leaving a kill to spin on it.
	group_reserve record
	if ! mine; then
		group_release record
		return 0
	fi
	group_run record pw-record "${target[@]}" --rate 16000 --channels 1 --format s16 "$WAV" 2>>"$LOG" &
	notify "J'écoute…" "Appuie à nouveau quand tu as fini."
	return 0
}

# ------------------------------------------------------------------ le bruit

# True when a transcript is not somebody talking.
#
# The empty-transcript guard below cannot catch this, and that is the whole
# problem: whisper never answers silence with nothing. It answers with the
# thing it read most during training — subtitle credits — so an empty room
# becomes « Sous-titres réalisés par la communauté d'Amara.org », and every
# organ downstream treats it as a question. It cost a brain call, a spoken
# reply, a journal line the dreams later read as fact, and a $LAST_ASK
# pushed forward that suppressed the next round for ten minutes. Nine times
# on 2026-09-01.
#
# The table is memory/NOISE.md, one ERE per line. Each is anchored HERE
# rather than in the file, so a pattern always describes a WHOLE transcript
# and « trouve-moi les sous-titres de ce film » cannot fall into one that
# describes an entire credit line. That anchoring is what the negative
# assertions in tests/run exist to hold.
is_noise() {
	local pats
	pats=$(sed '/<!--/,/-->/d' "$MEMORY_DIR/NOISE.md" 2>/dev/null |
		sed 's/[[:space:]]*$//' | grep -v '^[[:space:]]*$' | grep -v '^#' |
		sed 's/^/^(/; s/$/)$/')
	[[ -n $pats ]] || return 1
	grep -qiE -f <(printf '%s\n' "$pats") <<<"$1"
}

do_finish() {
	local text lang pgid
	# Claim and leave `listening` FIRST, before the recorder is even
	# signalled. The kill and the header grace below take between a tenth of
	# a second and a full second, and for all of it the machine used to
	# still read `listening`: a second press landing in that window — the
	# button and the wake daemon's silence timer together — transcribed the
	# same utterance twice and asked the brain the same question twice.
	claim_transition finish || return 1
	stage_guard
	pgid=$(group_pgid record)
	kill_group record INT
	# Give pw-record a beat to finalize the WAV header.
	group_gone "$pgid"
	# That grace is up to a full second, and « stop, no, cancel » is a very
	# ordinary pair of gestures to make inside it. Whisper is the expensive
	# organ in this file after the brain, and there is no point spending it
	# on a recording nobody wants any more.
	mine || return 0
	if [[ ! -s $WAV ]]; then
		transition rest
		notify "Jarvis" "Je n'ai rien entendu."
		return 1
	fi
	# The other silence, and the one that fooled every check for a day: a
	# muted or dead node records perfectly well. The file is long, its header
	# is intact, and every sample is zero — so `-s` above is satisfied and
	# whisper, handed digital silence, answers with the subtitle credits it
	# was trained on. Counting the non-NUL bytes settles it for nothing:
	# measured here, 30 in 78 kB of muted capture (the header, and no more)
	# against 66 819 for a real quiet room, whose dither is never zero. This
	# catches the unplugged jack and the broken graph too, not only the mute.
	if (($(tr -d '\0' <"$WAV" | wc -c) <= 64)); then
		rm -f "$WAV"
		transition rest
		notify "Je n'ai rien entendu." "Ton micro ne capte rien."
		return 1
	fi
	notify "Je réfléchis…"
	# The soul's `langue` setting pins the STT language (fr | en | auto):
	# whisper's auto-detection is unreliable on short clips. The effective
	# config is derived fresh so a settings change applies immediately.
	lang=$(grep -m1 '^- langue:' "$SOUL_FILE" 2>/dev/null | sed 's/^- langue: *//; s/ *$//')
	case "$lang" in fr | en) ;; *) lang=auto ;; esac
	sed "s/^language = .*/language = \"$lang\"/" "$STT_CONFIG" >"$RUN_DIR/voxtype.toml"
	text=$(group_run stt "$VOXTYPE" -c "$RUN_DIR/voxtype.toml" transcribe "$WAV" 2>>"$LOG" | tail -1)
	mine || return 0
	rm -f "$WAV"
	log "heard: $text"
	if [[ -z ${text// /} ]]; then
		note_failure "transcript vide : la reconnaissance vocale n'a rien produit"
		do_speak "Je n'ai rien entendu."
		return 1
	fi
	# Nobody said that. It is not a failure either — there is nothing to
	# distil into a lesson and nothing to schedule a dream about — so it
	# goes no further than the log and a puzzled fish. In particular
	# $LAST_ASK is left exactly where it was: it is what the rounds read to
	# know whether they would be interrupting, and a hallucination that
	# moves it steals the next ten minutes from a user who never spoke.
	if is_noise "$text"; then
		log "noise: $text"
		transition rest
		mascot_emote curious
		return 0
	fi
	transition ask || return 1
	run_exchange "$text"
}

# Every handle, in one gesture. The recorder gets INT so its WAV header is
# finalized on the way out; everything else gets TERM. Killing the GROUP is
# what makes this real: `claude` runs its own Bash tool subprocesses, and
# the bare pid this used to signal never reached a single one of them.
stop_everything() {
	local name
	kill_group record INT
	for name in stt brain voice play dream; do
		kill_group "$name"
	done
	# A cancelled recording left on disk was transcribed by the next press.
	rm -f "$WAV"
}

# -------------------------------------------------------------- the events

# The abort. It is the one gesture in the system that is not allowed to fail,
# so it does nothing that can: it never asks the brain anything, never waits
# on anything, and lands on idle even if every single kill misses.
#
# The claim comes first, and it is what actually cancels: from that line on
# the running invocation is no longer the owner, so every `mine` inside it
# fails and it stops writing to the world in the moment before its process
# group even dies — no notification with the answer you just refused, no
# journal line, no theme changed three seconds later. Then the fish (its own
# animation, not a state sprite), the groups, the abort journal, and home.
#
#   --say         speak the confirmation. For the abort the user cannot see
#                 — the wake word, from across the room. A press already has
#                 its own answer: the silence that follows it.
#   --from <mot>  who asked, for the journal: touche, voix, commande.
do_cancel() {
	local say=0 trigger=commande was held
	while (($#)); do
		case "$1" in
		--say) say=1 ;;
		--from)
			trigger="${2:-commande}"
			shift
			;;
		esac
		shift
	done
	was=$(state)
	held=$(held_ms)
	claim_transition cancel || return 1
	stage_guard
	mascot abort
	stop_everything
	# Nothing was under way: the key still answers, but there is no gesture
	# to record — an abort journal full of « annulé pendant son repos » would
	# hide the pattern it exists to show.
	case "$was" in idle | cancelling) ;; *) note_abort "$was" "$held" "$trigger" ;; esac
	notify "Jarvis" "Annulé."
	transition rest
	((say)) && do_speak "Annulé."
	return 0
}

# The one button — and it is modal, which is the whole of workstream 3. There
# is exactly one of it, three surfaces reach it (the push-to-talk key, the
# Touch Bar button, a click on the fish), and for the two states where the
# machine is working on your behalf it used to do precisely nothing: while he
# transcribed or thought, no key, no button and no click in the entire system
# could stop him. So the same press aborts there, and the three surfaces are
# armed by this one arm with no change outside this file.
on_press() {
	# A quarter of a second of dead time on every press. Two events a
	# fraction of a second apart — the button under a thumb and the wake
	# daemon's silence timer firing together — are one gesture, not two, and
	# treating them as two is what asked the brain the same question twice.
	if ! held_for 250; then
		log "press ignored: $(state) for less than 250 ms"
		return 0
	fi
	# The state read here is only a hint: do_listen and do_finish decide for
	# real, under the lock, and refuse what the table refuses.
	case "$(state)" in
	idle | followup)
		do_listen
		;;
	listening)
		do_finish
		;;
	speaking)
		# Barge-in: the speaking invocation wakes from its player, finds the
		# epoch moved, and writes nothing more. `touche` is the same word the
		# modal arm below files, because it is the same gesture on the same
		# three surfaces — only the moment it lands in differs.
		do_listen touche
		;;
	transcribing | thinking)
		# The modal arm. A second and a half of dead time, and it is a
		# different number from the one above on purpose: this press does not
		# advance anything, it destroys work in progress, so a fumbled
		# double-press — a thumb that bounced on the key that STARTED this
		# request — must not be able to abort it one second in. Past that,
		# the gesture is deliberate and it is obeyed.
		if held_for 1500; then
			do_cancel --from touche
		else
			log "press ignored: $(state) for less than 1.5 s"
		fi
		;;
	sleeping)
		# Waking him mid-dream. The abort first, and it means it now — the
		# dream's session runs in a group of its own — then the ear, because
		# what the user wanted was to talk, not to watch a fish wake up.
		do_cancel --from touche
		do_listen
		;;
	cancelling)
		# An abort is already under way and it takes milliseconds. Pressing
		# through it would open the microphone on top of groups still dying.
		log "press ignored while $(state)"
		;;
	esac
}

mkdir -p "$MEMORY_DIR"
memory_init

case "${1:-press}" in
press | listen)
	on_press
	;;
cancel)
	# SUPER+ALT+ESCAPE, the fish's right click, the prompt bar's Escape, the
	# wake word while he works (`cancel --say --from voix`), and on_press's
	# modal arm all end here.
	shift
	do_cancel "$@"
	;;
reset)
	rm -f "$CONV_FLAG"
	notify "Jarvis" "Nouvelle conversation — l'âme a été relue."
	;;
settle)
	# The wake daemon closes an unused follow-up window quietly. It never
	# claimed anything, so the table alone decides: `settle` is legal from
	# `followup` and from nowhere else, and a window that already closed
	# leaves a refusal in the log rather than an idle written over a state
	# somebody else owns.
	transition settle || true
	;;
watchdog)
	# The chien de garde, run by the pulse. Cancelling answers « the user
	# wants out »; this answers « the stage never came back ». The Wi-Fi
	# drops mid-question and he ponders forever: no timeout anywhere, every
	# input a no-op, and — because the mascot's pulse only ran while idle —
	# the entire body clock stopped behind it. No rounds, no dreams, no
	# retry of parked documents, no conversation rotation, silently, until
	# logout. With `since` and `owner` in the record it costs thirty lines,
	# and it is what makes the more aggressive press grammar safe: every
	# wedge becomes an ordinary abort with a French explanation.
	age=$(state_age)
	rec_read
	stuck=$REC_STATE
	seen=$REC_EPOCH
	deadline=$(deadline_for "$stuck")
	# idle has no deadline, and neither has anything the table does not know.
	((deadline)) || exit 0
	# The owner is the other half of the answer: an invocation that died —
	# killed, a terminal closed on it, an OOM — is never coming back
	# whatever the clock says. It is only ever ASKED whether it exists; it
	# is not a kill target, since an invocation launched from a shell shares
	# that shell's process group. And `listening` and `followup` are judged
	# by the clock alone: those two are deliberately handed on to the next
	# press and to the wake daemon, so their owner is EXPECTED to be gone —
	# they are the same two finish_stage leaves alone, for the same reason.
	gone=0
	case "$stuck" in
	listening | followup) ;;
	*) ((REC_OWNER > 1)) && ! kill -0 "-$REC_OWNER" 2>/dev/null && gone=1 ;;
	esac
	# One grace extension, on a sign of life and nothing else: the black box
	# takes a line per tool call the brain makes, so a trace that grew in
	# the last thirty seconds is a brain visibly still working — a long
	# answer with six tool calls is slow, not stuck. It buys one deadline,
	# once, never a second. (stat rather than `find -newermt`: find is bfs
	# on this machine and its timestamps are integer minutes only.)
	moved=$(stat -c %Y "$MEMORY_DIR/trace/$(date +%F).log" 2>/dev/null || echo 0)
	if ((!gone && age > deadline && $(date +%s) - moved < 30)); then
		log "watchdog: $stuck past ${deadline}s but the trace is still moving — one extension"
		deadline=$((deadline * 2))
	fi
	((gone || age > deadline)) || exit 0
	# The follow-up window is not a wedge, it is a window nobody closed. The
	# wake daemon settles it in six seconds when it is alive; this is the
	# same exit two seconds later, and it is why killing that daemon can no
	# longer leave the fish perked up until logout. Nothing is killed,
	# nothing is noted, nothing is said.
	if [[ $stuck == followup ]]; then
		log "watchdog: follow-up window closed after ${age}s"
		transition settle || true
		exit 0
	fi
	((gone)) && why="propriétaire disparu" || why="délai dépassé"
	log "watchdog: $stuck for ${age}s — $why (deadline ${deadline}s, owner $REC_OWNER)"
	# Claim only if the machine is still the one judged above: between the
	# reading and here it may have come back by itself, and killing then
	# would kill an exchange that is doing nothing wrong.
	claim_if "$seen" cancel || exit 0
	# The freeing itself is now a stage like any other, and the one stage
	# with nobody behind it to notice: if the pulse's own unit is stopped
	# mid-abort, `cancelling` would sit there until the next pulse found it
	# and freed it in turn. It heals either way; this makes it immediate.
	stage_guard
	stop_everything
	# A wedge IS a failure — unlike an abort, which is the user changing his
	# mind — so it belongs in the journal a dream reads for root causes.
	note_failure "chien de garde : figé pendant $(stage_fr "$stuck") depuis $age s ($why), retour au repos"
	transition rest
	mascot_emote worried
	notify "Jarvis" "Jarvis s'était figé pendant $(stage_fr "$stuck") ; il est revenu au repos."
	;;
dispatch)
	# A background mission: work too big for a spoken exchange (coding,
	# multi-step jobs) goes to a detached Claude session in the target
	# directory. Jarvis stays free; the result comes back as a bubble, a
	# notification, a journal line — and out loud if he is idle then.
	shift
	dir="$JARVIS_DIR"
	if [[ ${1:-} == --dir ]]; then
		dir="$2"
		shift 2
	fi
	task="$*"
	if [[ -z ${task// /} ]]; then
		echo "usage: jarvis dispatch [--dir <dir>] <task>" >&2
		exit 1
	fi
	if [[ ! -d $dir ]]; then
		echo "no such directory: $dir" >&2
		exit 1
	fi
	mkdir -p "$STATE_DIR/missions"
	mission="$STATE_DIR/missions/$(date +%Y%m%d-%H%M%S).log"
	log "dispatch($dir): $task"
	trace "— mission ($dir) : $task —"
	journal "mission lancée dans $dir : « $task »"
	notify "Jarvis — mission lancée" "$task"
	(
		cd "$dir" || exit 1
		printf 'dir: %s\ntask: %s\n---\n' "$dir" "$task" >"$mission"
		claude -p --model "${JARVIS_DISPATCH_MODEL:-sonnet}" \
			--permission-mode acceptEdits \
			--output-format stream-json --include-partial-messages --verbose \
			-- "$task"$'\n\nTermine ta réponse par UNE phrase de compte rendu, orale, en français.' 2>>"$mission" |
			"$JARVIS_DIR/bin/jarvis-sentences" --quiet "$mission.reply"
		result=$(cat "$mission.reply" 2>/dev/null)
		printf '%s\n' "$result" >>"$mission"
		summary=$(printf '%s' "$result" | tail -n 1)
		if [[ -z ${summary// /} ]]; then
			summary="La mission a échoué — voyez le journal des missions."
			note_failure "mission échouée dans $dir : « $task » ($mission)"
			mascot_emote worried
		else
			mascot_emote celebrate
		fi
		journal "mission terminée : $summary"
		trace "mission terminée : $summary"
		mascot_aside "$summary"
		notify "Jarvis — mission terminée" "$summary"
		[[ $(state) == idle ]] && ! quiet_now && "$0" say "$summary"
	) >/dev/null 2>&1 &
	disown
	echo "mission lancée : $mission"
	;;
ask)
	shift
	if [[ ${1:-} == --quiet ]]; then
		QUIET=1
		shift
	fi
	# A typed question is a fresh start: it takes the machine, and taking the
	# machine means nothing else is still holding an organ — an ear left open
	# by a press, a player, a brain still streaming the previous answer.
	# The guard goes up with the claim and not after the killing, as it does
	# at every other entry point: the stop is not instant, and a question
	# killed while it clears the floor would leave `thinking` behind it.
	claim_transition ask || exit 1
	stage_guard
	stop_everything
	run_exchange "$*"
	;;
say)
	shift
	claim
	stage_guard
	do_speak "$*"
	;;
note)
	shift
	note_failure "$*"
	;;
# The noise table, assertable without a microphone: exit 0 means « personne
# n'a dit ça ». It is how the whole of memory/NOISE.md — the credits it must
# catch AND the real requests it must never eat — is held by tests/run in
# milliseconds, with no audio, no model and no real time.
noise\?)
	shift
	is_noise "$*"
	exit $?
	;;
dream)
	# Consolidate memory: a dedicated Claude session reads the failure
	# journal, distills lessons into LEARNED.md, files suggestions, and
	# reports in one sentence. The fish sleeps through it. With --quiet
	# (the opportunistic idle dream) the summary goes to the bubble and a
	# notification only — he does not talk in his sleep.
	quiet=0
	[[ ${2:-} == --quiet ]] && quiet=1
	touch "$STATE_DIR/last-dream"
	# The body is only taken when the body is free: `sleep` is legal from
	# `idle` and from nowhere else, so a dream asked for while he is
	# answering someone — the Control Center's button, or the idle nap
	# racing an exchange that just started — consolidates in the background
	# and never once touches the state, the bubble or the voice. It never
	# claimed, and `mine` is false for an invocation that did not.
	if claim_transition sleep; then
		stage_guard
	fi
	notify "Jarvis" "Jarvis rêve — consolidation de la mémoire…"
	cd "$JARVIS_DIR" || exit 1
	trace "— rêve —"
	# In a group of its own, under a name of its own: a dream is the one
	# autonomous session that can hold the body, so the abort and the
	# watchdog both need a handle on it. Waking him mid-dream used to
	# silence the dream without ever stopping it — it went on rewriting
	# LEARNED.md for a minute after the fish had opened its ear.
	group_run dream claude -p --model "${JARVIS_DREAM_MODEL:-sonnet}" \
		--output-format stream-json --include-partial-messages --verbose \
		-- "$(cat "$MEMORY_DIR/DREAM_PROMPT.md")" 2>>"$LOG" |
		"$JARVIS_DIR/bin/jarvis-sentences" --quiet "$RUN_DIR/dream.txt"
	summary=$(cat "$RUN_DIR/dream.txt" 2>/dev/null)
	log "dream(quiet=$quiet): $summary"
	if ! brain_check "${summary:-$(cat "$RUN_DIR/dream.txt.error" 2>/dev/null)}"; then
		# The brain reported on itself (brain_set already told the user);
		# a usage notice is not a dream worth journaling or speaking.
		mine && transition rest
		exit 1
	fi
	[[ -n ${summary:-} ]] && journal "rêve : $summary"
	notify "Jarvis" "${summary:-Le rêve a tourné court. Voyez le journal.}"
	if [[ -n ${summary:-} ]]; then
		mascot_aside "$summary"
		(( quiet )) || do_speak "$summary"
	fi
	if mine; then
		case "$(state)" in sleeping | speaking) transition rest ;; esac
	fi
	;;
heartbeat)
	# The proactive round: Jarvis inspects the machine against his
	# checklist and only surfaces what deserves attention. Observation
	# only — he changes nothing. Quiet by design: bubble + notification.
	touch "$STATE_DIR/last-heartbeat"
	cd "$JARVIS_DIR" || exit 1
	trace "— ronde —"
	claude -p --model "${JARVIS_HEARTBEAT_MODEL:-haiku}" \
		--output-format stream-json --include-partial-messages --verbose \
		-- "$(cat "$MEMORY_DIR/HEARTBEAT_PROMPT.md")" 2>>"$LOG" |
		"$JARVIS_DIR/bin/jarvis-sentences" --quiet "$RUN_DIR/heartbeat.txt"
	report=$(cat "$RUN_DIR/heartbeat.txt" 2>/dev/null)
	log "heartbeat: $report"
	# A usage limit or a stall on a permission prompt is news about the
	# brain, not about the machine: brain_set tells the user once, in
	# French, and the raw notice stays out of the bubble.
	brain_check "${report:-$(cat "$RUN_DIR/heartbeat.txt.error" 2>/dev/null)}" ronde || exit 1
	if [[ -n ${report:-} && $report != "RAS" && ${report:0:4} != "RAS." ]]; then
		journal "ronde : $report"
		mascot_emote worried
		mascot_aside "$report"
		notify "Jarvis — ronde" "$report"
	fi
	;;
digest)
	# The inbox: a file dropped in ~/Jarvis/input becomes a fiche in
	# memory/knowledge/inbox/. Claim first — moving files out of input/
	# is what keeps the systemd path unit (PathExistsGlob) quiet — then
	# one CONTAINED session per file: a dropped document is untrusted
	# input, so its session gets no Bash and can only read, and write
	# its fiche. Quota parks files in .pending/ (tick retries them);
	# three real failures give up into .failed/.
	exec 9>"$RUN_DIR/digest.lock"
	flock -n 9 || exit 0
	box_init
	inbox="$BOX_DIR/input"
	declare -A tries=()
	claimed=()
	leftover=0
	shopt -s nullglob
	# Orphans of a crashed run first (the lock makes adopting them safe).
	for f in "$inbox/.work"/*; do
		[[ -f $f ]] || continue
		claimed+=("$f")
		tries[$(basename "$f")]=0
	done
	# Fresh drops. A file still being copied (moving size, or a
	# downloader's .part) stays put; we exit slowly so the path unit
	# polls instead of spinning.
	for f in "$inbox"/*; do
		[[ -f $f ]] || continue
		base=$(basename "$f")
		case "$base" in *.part | *.crdownload) leftover=1; continue ;; esac
		size=$(stat -c %s "$f" 2>/dev/null) || continue
		sleep 2
		[[ $(stat -c %s "$f" 2>/dev/null) == "$size" ]] || { leftover=1; continue; }
		mv "$f" "$inbox/.work/$base" 2>/dev/null || { leftover=1; continue; }
		claimed+=("$inbox/.work/$base")
		tries[$base]=0
	done
	# Parked retries, unless the brain is still out of quota.
	gate=0
	case "$(brain_status)" in quota\ *) gate=$(brain_status | cut -d' ' -f2) ;; esac
	if (($(date +%s) >= gate)); then
		for f in "$inbox/.pending"/*; do
			[[ -f $f ]] || continue
			base=$(basename "$f")
			mv "$f" "$inbox/.work/$base" 2>/dev/null || continue
			tries[$base]=$(cat "$inbox/.pending/.tries.$base" 2>/dev/null || echo 0)
			rm -f "$inbox/.pending/.tries.$base"
			claimed+=("$inbox/.work/$base")
		done
	fi
	shopt -u nullglob
	if ((${#claimed[@]} == 0)); then
		((leftover)) && sleep 28
		exit 0
	fi
	mkdir -p "$MEMORY_DIR/knowledge/inbox"
	digested=0
	for f in "${claimed[@]}"; do
		base=$(basename "$f")
		# Quota can land mid-batch: park the rest without burning tries.
		gate=0
		case "$(brain_status)" in quota\ *) gate=$(brain_status | cut -d' ' -f2) ;; esac
		if (($(date +%s) < gate)); then
			mv "$f" "$inbox/.pending/$base"
			printf '%s' "${tries[$base]}" >"$inbox/.pending/.tries.$base"
			continue
		fi
		slug=$(printf '%s' "${base%.*}" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null |
			tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//' | cut -c1-48)
		fiche="$MEMORY_DIR/knowledge/inbox/$(date +%F)-${slug:-document}.md"
		n=2
		while [[ -e $fiche ]]; do
			fiche="$MEMORY_DIR/knowledge/inbox/$(date +%F)-${slug:-document}-$n.md"
			n=$((n + 1))
		done
		# A .url file (or a lone URL) may fetch its page; nothing else may.
		extra=()
		if [[ $base == *.url ]] || { (($(wc -c <"$f") < 500)) && [[ $(grep -c . "$f") == 1 ]] && grep -qE '^[[:space:]]*https?://[^[:space:]]+[[:space:]]*$' "$f"; }; then
			extra=(--allowedTools WebFetch)
		fi
		trace "— digestion : $base —"
		cd "$JARVIS_DIR" || exit 1
		rm -f "$RUN_DIR/digest.txt" "$RUN_DIR/digest.txt.error"
		claude -p --model "${JARVIS_DIGEST_MODEL:-sonnet}" \
			--disallowedTools Bash Edit NotebookEdit Task WebSearch "${extra[@]}" \
			--output-format stream-json --include-partial-messages --verbose \
			-- "$(cat "$MEMORY_DIR/DIGEST_PROMPT.md")"$'\n\n'"Fichier : $f"$'\n'"Fiche : $fiche" 2>>"$LOG" |
			"$JARVIS_DIR/bin/jarvis-sentences" --quiet "$RUN_DIR/digest.txt"
		summary=$(cat "$RUN_DIR/digest.txt" 2>/dev/null)
		if brain_check "${summary:-$(cat "$RUN_DIR/digest.txt.error" 2>/dev/null)}"; then
			brain_ok=1
		else
			brain_ok=0
		fi
		if ((brain_ok)) && [[ -s $fiche ]]; then
			dest="$inbox/.archive/$base"
			[[ -e $dest ]] && dest="$inbox/.archive/$(date +%s)-$base"
			mv "$f" "$dest"
			log "digest: $base -> $fiche"
			journal "digestion : $base → knowledge/inbox/$(basename "$fiche")"
			trace "✓ digéré : $base → $(basename "$fiche")"
			digested=1
			mascot_emote curious
			notify "Jarvis — document digéré" "${summary:-$base}"
			[[ $(state) == idle ]] && ! quiet_now && "$0" say "$summary"
		elif ((brain_ok)); then
			# The brain answered but produced no fiche: the file's fault.
			t=$((${tries[$base]} + 1))
			if ((t >= 3)); then
				mv "$f" "$inbox/.failed/$base"
				note_failure "digestion abandonnée après $t essais : $base"
				notify "Jarvis" "Impossible de digérer $base — voyez ~/Jarvis/input/.failed."
			else
				mv "$f" "$inbox/.pending/$base"
				printf '%s' "$t" >"$inbox/.pending/.tries.$base"
			fi
		else
			# The brain reported on itself (brain_set already told the
			# user): park unchanged, tick will retry.
			mv "$f" "$inbox/.pending/$base"
			printf '%s' "${tries[$base]}" >"$inbox/.pending/.tries.$base"
		fi
	done
	((digested)) && "$JARVIS_DIR/bin/jarvis-index" --inbox >/dev/null 2>&1
	;;
lastcmd)
	# The last finished shell command, straight from atuin's database
	# (its CLI needs a session it does not have here): one line the
	# brain can read — command, exit code, duration, when.
	sqlite3 -separator $'\t' "$HOME/.local/share/atuin/history.db" \
		"select command, exit, duration, timestamp from history order by timestamp desc limit 1" 2>/dev/null |
		awk -F'\t' '{ d = $3 / 1e9; code = ($2 < 0 ? "inconnu (encore en cours ?)" : $2); printf "commande : %s\ncode de sortie : %s\ndurée : %.1f s\nil y a : %d min\n", $1, code, d, (systime() - $4 / 1e9) / 60 }'
	;;
missed)
	# Notifications since the last exchange (or the last N minutes):
	# the notification-center's archive, one line each, newest last.
	since=$(stat -c %Y "$LAST_ASK" 2>/dev/null || echo 0)
	[[ ${2:-} =~ ^[0-9]+$ ]] && since=$(($(date +%s) - $2 * 60))
	python3 - "$since" "$HOME/.local/state/omarchy/notification-center/archive" <<'EOF'
import json, os, sys, time
since, d = int(sys.argv[1]) * 1000, sys.argv[2]
rows = []
for name in (os.listdir(d) if os.path.isdir(d) else []):
    try:
        n = json.load(open(os.path.join(d, name)))
    except Exception:
        continue
    if n.get("timestamp", 0) >= since:
        rows.append(n)
rows.sort(key=lambda n: n.get("timestamp", 0))
for n in rows:
    t = time.strftime("%H:%M", time.localtime(n["timestamp"] / 1000))
    body = " ".join(str(n.get("body", "")).split())[:120]
    print(f"{t} {n.get('app', '?')} — {n.get('summary', '')}" + (f" : {body}" if body else ""))
print(f"({len(rows)} notification(s))" if rows else "(rien de nouveau)")
EOF
	;;
save)
	# « Enregistre ça » : the clipboard into the inbox — a lone URL as a
	# .url (WebFetch digests the page), an image as a .png, text as .md.
	box_init
	stamp=$(date +%Y%m%d-%H%M%S)
	if wl-paste --list-types 2>/dev/null | grep -q '^image/png'; then
		wl-paste --type image/png >"$BOX_DIR/input/capture-$stamp.png"
		what="l'image"
	else
		text=$(wl-paste --no-newline 2>/dev/null)
		# Nothing copied: fall back to the selection (a link merely
		# highlighted in a browser lives there, not in the clipboard).
		[[ -z ${text// /} ]] && text=$(wl-paste --primary --no-newline 2>/dev/null)
		if [[ -z ${text// /} ]]; then
			notify "Jarvis" "Le presse-papier est vide."
			exit 1
		fi
		if [[ $text =~ ^https?://[^[:space:]]+$ ]]; then
			printf '%s\n' "$text" >"$BOX_DIR/input/lien-$stamp.url"
			what="le lien"
		else
			printf '%s\n' "$text" >"$BOX_DIR/input/note-$stamp.md"
			what="le texte"
		fi
	fi
	log "save: $what"
	mascot_emote curious
	notify "Jarvis" "Je digère $what."
	;;
greet)
	# The unlock hello: a bubble (never the voice) with what happened
	# while the user was away — rounds, dreams, digestions, missions,
	# the closed conversation — at most once per half hour, and only
	# if there is something to tell.
	stamp="$STATE_DIR/last-greet"
	[[ -e $stamp && -n $(find "$stamp" -mmin -30 2>/dev/null) ]] && exit 0
	since=$(stat -c %Y "$LAST_ASK" 2>/dev/null || echo 0)
	[[ -e $stamp ]] && (($(stat -c %Y "$stamp") > since)) && since=$(stat -c %Y "$stamp")
	touch "$stamp"
	# The journal carries clock faces, not dates, so `since` has to be one
	# too — and a clock face from another day compares as a plain string:
	# after an evening session, "07:30" >= "18:00" is false and the whole
	# morning stays untold. Anything older than today starts at midnight.
	from=$(date -d "@$since" +%H:%M)
	[[ $(date -d "@$since" +%F) == $(date +%F) ]] || from=00:00
	lines=$(awk -v since="$from" '
		/^- [0-9][0-9]:[0-9][0-9] / { t = $2; sub(/^- [0-9:]+ /, ""); if (t >= since && $0 ~ /^(ronde|rêve|digestion|mission terminée|conversation)/) print }
	' "$MEMORY_DIR/journal/$(date +%F).md" 2>/dev/null | tail -4)
	[[ -n $lines ]] || exit 0
	summary=$(printf '%s' "$lines" | sed 's/^[a-zé ]* : //' | awk '{ printf "%s%s", (NR > 1 ? " " : ""), $0 }' | cut -c1-240)
	mascot_aside "Pendant ton absence : $summary"
	log "greet: $summary"
	;;
look)
	# The fish's appearance: regenerate the mascot's sprite sheets from
	# the soul's look settings (corps, oeil, criniere, queue, couleur)
	# and make the plugin reload them — the fish on screen IS the
	# preview. `look random` rolls a new fish first.
	if [[ ${2:-} == random ]]; then
		pick() { local -a v=("$@"); echo "${v[RANDOM % ${#v[@]}]}"; }
		set_setting corps "$(pick B1 B2 B3 B4)"
		set_setting oeil "$(pick E1 E2 E3 E4)"
		set_setting criniere "$(pick M1 M2 M3 M4)"
		set_setting queue "$(pick T1 T2 T3 T4)"
		set_setting couleur "$(pick or corail lagon lavande menthe perle braise encre)"
	fi
	mkdir -p "$SPRITES_DIR"
	if ! python3 "$JARVIS_DIR/sprites/generate.py" \
		--body "$(setting corps B1)" --eye "$(setting oeil E1)" --crest "$(setting criniere M1)" \
		--tail "$(setting queue T1)" --pal "$(setting couleur or)" --out "$SPRITES_DIR" >>"$LOG" 2>&1; then
		notify "Jarvis" "Impossible de générer le poisson — voyez le journal."
		exit 1
	fi
	# The stamp is written only here, after a generation that succeeded, and
	# it is what lets doctor tell « the fish on disk is the fish the soul
	# describes » from « the fish on disk is the one from before ».
	look_signature >"$SPRITES_DIR/.look"
	log "look: $(look_signature)"
	mascot reload
	;;
index)
	# Rebuild the knowledge base from live introspection (deterministic).
	out=$("$JARVIS_DIR/bin/jarvis-index" 2>>"$LOG")
	log "$out"
	journal "$out"
	notify "Jarvis" "$out"
	;;
tick)
	# The pulse. It is a systemd timer now (systemd/jarvis-tick.timer, every
	# sixty seconds) and no longer the mascot's Timer, which only ran while
	# the fish was idle: the one thing able to repair a wedged machine was
	# the one thing a wedged machine stopped, and with it went the rounds,
	# the dreams, the retries of parked documents and the conversation
	# rotation — silently, until logout. The timer survives a wedge, a shell
	# reload, a hidden mascot and a plugin that is not installed at all.
	#
	# The watchdog runs first, before anything below reads the state: every
	# guard here is written for a machine that tells the truth about what it
	# is doing.
	"$0" watchdog
	# One truth about the quiet hours, refreshed on the pulse and not only
	# on a transition: a machine that idles across the 23:00 boundary wore
	# yesterday's flag until somebody finally spoke to it.
	printf '%s' "$(quiet_now && echo 1 || echo 0)" >"$STATE_DIR/quiet"
	# The exchange box first (MakeDirectory cannot create the parent of a
	# glob), then the mechanical upkeep: after an omarchy update the
	# knowledge base is stale — reindex, no LLM needed.
	box_init
	# Only when a fiche actually arrived. The pulse used to be the mascot's
	# five minutes and is a systemd minute now, and an index rewritten every
	# sixty seconds is a disk woken up for nothing.
	inbox_index="$MEMORY_DIR/knowledge/inbox/INDEX.md"
	if [[ ! -e $inbox_index || -n $(find "$MEMORY_DIR/knowledge/inbox" -newer "$inbox_index" -print -quit 2>/dev/null) ]]; then
		"$JARVIS_DIR/bin/jarvis-index" --inbox >/dev/null 2>&1
	fi
	if [[ "$(omarchy version 2>/dev/null)" != "$(cat "$MEMORY_DIR/knowledge/VERSION" 2>/dev/null)" ]]; then
		"$0" index
	fi
	# Once a day, the self-check — deterministic, no brain, no voice — and
	# only what went red SINCE the last one is worth saying out of it. A
	# daily litany of the same missing voice model is how a warning becomes
	# wallpaper; a line that turns red today is news.
	#
	# It runs before both guards below, and deliberately: a machine whose
	# brain is out of quota is exactly the one whose body deserves a look,
	# and the check itself costs nothing and says nothing. Only the
	# notification is held back at night — that, and not the diagnosis, is
	# what the soul's `silence` is about.
	stamp="$STATE_DIR/last-doctor-run"
	if [[ ! -e $stamp || -z $(find "$stamp" -mmin -1440 2>/dev/null) ]]; then
		touch "$stamp"
		red=$("$0" doctor --quiet | sort)
		new=$(comm -13 <(sort -u "$STATE_DIR/last-doctor" 2>/dev/null) <(printf '%s\n' "$red" | grep -v '^$'))
		printf '%s\n' "$red" >"$STATE_DIR/last-doctor"
		if [[ -n ${new//[[:space:]]/} ]]; then
			# One line, joined in bash: `paste -sd'; '` cycles through the
			# delimiters given, so it wrote « a;b c » and not « a; b; c ».
			summary=${new//$'\n'/; }
			log "doctor: nouveau(x) problème(s) — $summary"
			quiet_now || notify "Jarvis — bilan de santé" "$summary"
		fi
	fi
	# Quiet hours: nothing autonomous from here on.
	quiet_now && exit 0
	# A brain that said it is out of quota until a given hour: nothing that
	# needs it until then.
	case "$(brain_status)" in
	quota\ *) (($(date +%s) < $(brain_status | cut -d' ' -f2))) && exit 0 ;;
	esac
	# The body tells the truth, without the brain: a nearly full disk
	# worries him (once a day), available updates make him curious (the
	# check fetches, so at most every six hours, in the background).
	stamp="$STATE_DIR/emote-disk"
	if (($(df --output=pcent / 2>/dev/null | tail -1 | tr -dc 0-9) >= 90)) && [[ ! -e $stamp || -z $(find "$stamp" -mmin -1440 2>/dev/null) ]]; then
		touch "$stamp"
		mascot_emote worried
		notify "Jarvis" "Le disque est presque plein."
	fi
	stamp="$STATE_DIR/emote-updates"
	if [[ ! -e $stamp || -z $(find "$stamp" -mmin -360 2>/dev/null) ]]; then
		touch "$stamp"
		(omarchy-update-available >/dev/null 2>&1 && mascot_emote curious) &
	fi
	# Documents parked in the inbox while the brain was out: retry now.
	if [[ -n $(find "$BOX_DIR/input/.pending" -maxdepth 1 -type f ! -name '.*' -print -quit 2>/dev/null) ]]; then
		"$0" digest
	fi
	# A conversation untouched for eight hours is over: consolidate
	# and close it — a night's sleep rotates every morning.
	if [[ -e $CONV_FLAG && -z $(find "$CONV_FLAG" -mmin -480 2>/dev/null) ]]; then
		"$0" rotate
	fi
	# Then: nap first if there is memory to digest, otherwise consider a
	# round. Each branch keeps its own guards; the soul can switch either off.
	[[ $(setting reves oui) == non ]] || "$0" maybe-dream
	[[ $(state) == idle ]] || exit 0
	[[ $(setting rondes oui) == non ]] && exit 0
	[[ -e $LAST_ASK && -n $(find "$LAST_ASK" -mmin -10 2>/dev/null) ]] && exit 0
	[[ -e $STATE_DIR/last-heartbeat && -n $(find "$STATE_DIR/last-heartbeat" -mmin -60 2>/dev/null) ]] && exit 0
	exec "$0" heartbeat
	;;
maybe-dream)
	# The opportunistic nap, ticked whenever Jarvis idles: dream only when
	# there is something to digest, no conversation is fresh (last exchange
	# over 10 minutes ago), and the previous dream is more than 30 minutes
	# old.
	[[ $(state) == idle ]] || exit 0
	# Three entries, not one. A single line was enough to schedule a sonnet
	# session whose job is to rewrite LEARNED.md, which CLAUDE.md imports as
	# persona — so one transcript that came back empty could change who he
	# is. Three is the smallest number that can carry a pattern, which is
	# the only thing a dream is supposed to learn from.
	# grep -c prints the count AND exits nonzero on zero matches.
	entries=$(grep -c '^- \[' "$FAILURES" 2>/dev/null)
	((${entries:-0} >= 3)) || exit 0
	[[ -e $LAST_ASK && -n $(find "$LAST_ASK" -mmin -10 2>/dev/null) ]] && exit 0
	[[ -e $STATE_DIR/last-dream && -n $(find "$STATE_DIR/last-dream" -mmin -30 2>/dev/null) ]] && exit 0
	exec "$0" dream --quiet
	;;
rotate)
	# Close a stale conversation: ask the session itself for the summary
	# (it holds the context), keep it in memory/CONVERSATION.md (imported
	# by CLAUDE.md), then clear the flag so the next exchange starts
	# fresh — morning amnesia without forgetting. tick triggers this
	# when the conversation has been untouched for eight hours.
	id=$(cat "$CONV_FLAG" 2>/dev/null)
	[[ -n $id ]] || exit 0
	cd "$JARVIS_DIR" || exit 1
	trace "— rotation de conversation —"
	summary=$(claude -p --resume "$id" --model "${JARVIS_ROTATE_MODEL:-sonnet}" \
		-- "Notre conversation va être clôturée. Écris un résumé de cinq à dix lignes de ce fil pour ton futur toi : sujets abordés, préférences et faits durables exprimés par l'utilisateur, affaires en cours. Texte brut, sans markdown ni préambule." 2>>"$LOG")
	if ! brain_check "$summary"; then
		# Quota: keep the flag, tick retries once the brain is back.
		# Anything else means the session is unreachable — close it
		# without a summary rather than retrying forever.
		[[ $(brain_status) == quota* ]] && exit 1
		rm -f "$CONV_FLAG"
		journal "conversation close sans résumé (session injoignable)"
		trace "✗ rotation : session injoignable, conversation close"
		exit 1
	fi
	{
		printf '# CONVERSATION.md — le fil récent\n\n'
		printf '<!-- Écrit par `omarchy-jarvis rotate` : le résumé de la dernière\n     conversation close, importé dans CLAUDE.md. -->\n\n'
		printf 'Résumé du %s :\n\n%s\n' "$(date '+%F %H:%M')" "$summary"
	} >"$MEMORY_DIR/CONVERSATION.md"
	rm -f "$CONV_FLAG"
	log "rotate: conversation closed"
	journal "conversation résumée et close (rotation)"
	trace "✓ conversation résumée et close"
	;;
doctor)
	# The deterministic self-check: every dependency of the pipeline, green
	# or red, no LLM involved. Exit code = number of problems.
	#
	#   --quiet   the red lines only — what `tick` diffs once a day
	#   --mic     add the check that takes the microphone
	#
	# What it looks at has been rewritten against the failures actually seen
	# here rather than against the list of things that exist. `test -x` on
	# piper says nothing about a voice model truncated by a full disk: the
	# file is present, executable, correctly named, and silent. A colour
	# changed from the Control Center whose regeneration then failed leaves
	# the old fish on screen with nothing to notice it by. A checkout moved
	# to another directory leaves ~/.local/bin/omarchy-jarvis pointing at a
	# ghost, and every keybinding in the system with it.
	quiet=0 want_mic=0
	for arg in "$@"; do
		case "$arg" in
		--quiet) quiet=1 ;;
		--mic) want_mic=1 ;;
		esac
	done
	fails=0
	# Anything external gets five seconds and no more: this was a list of
	# commands trusted to return, and piper on a truncated model, systemctl
	# on a stuck bus and `claude` with no network are all things that do
	# not. The checks that are functions of ours are called directly —
	# `timeout` could not run them anyway, and they do nothing but read
	# files and take a non-blocking lock.
	chk() {
		local label="$1" rc
		shift
		if [[ $(type -t "$1") == function ]]; then
			"$@" >/dev/null 2>&1
		else
			timeout 5 "$@" >/dev/null 2>&1
		fi
		rc=$?
		if ((rc == 0)); then
			((quiet)) || printf '✓ %s\n' "$label"
		else
			printf '✗ %s\n' "$label"
			fails=$((fails + 1))
		fi
	}

	# The checks that need more than one command. Values reach them as
	# arguments or through the enclosing scope, never interpolated into a
	# quoted string: a space in $HOME is not supposed to become a bug in a
	# diagnostic tool.
	check_piper() {
		local out rc size
		out=$(mktemp) || return 1
		printf 'test' | timeout 5 "$PIPER" --model "$(voice_fr)" --output_file "$out" >/dev/null 2>&1
		rc=$?
		size=$(stat -c %s "$out" 2>/dev/null || echo 0)
		rm -f "$out"
		((rc == 0 && size > 0))
	}
	# The sheets by name, not by count: the mascot asks for them by name,
	# and a count turns every new sheet into a red line. `cancel` belongs on
	# this list like any other — Service.qml draws it on every abort, and a
	# checkout whose sprite engine predates it leaves the fish wearing the
	# previous strip with nothing to say why.
	check_sheets() {
		local sheet
		for sheet in idle listening thinking speaking cancel sleeping tired dnd worried proud curious celebrate; do
			[[ -e $SPRITES_DIR/$sheet.png ]] || return 1
		done
	}
	# The stamp `look` leaves beside the sheets holds the five settings they
	# were generated from. Comparing THOSE, rather than SOUL.md's mtime,
	# means a tone changed from the Control Center does not report a fish
	# that is perfectly up to date as stale.
	check_look() {
		[[ $(cat "$SPRITES_DIR/.look" 2>/dev/null) == "$(look_signature)" ]]
	}
	check_wake_venv() {
		timeout 5 "$JARVIS_DIR/wake/venv/bin/python" -c 'import openwakeword' 2>/dev/null
	}
	# Installed AND running: every unit the repository ships is expected in
	# ~/.config/systemd/user (install.sh puts it there), and every trigger
	# among them — the path watch, the pulse — is expected active.
	check_units() {
		local unit name
		for unit in "$JARVIS_DIR"/systemd/*; do
			[[ -e $unit ]] || continue
			[[ -e $HOME/.config/systemd/user/$(basename "$unit") ]] || return 1
		done
		for unit in "$JARVIS_DIR"/systemd/*.path "$JARVIS_DIR"/systemd/*.timer; do
			[[ -e $unit ]] || continue
			name=$(basename "$unit")
			timeout 5 systemctl --user --quiet is-active "$name" || return 1
		done
	}
	check_symlink() {
		[[ $(readlink -f "$HOME/.local/bin/omarchy-jarvis" 2>/dev/null) == "$(readlink -f "$JARVIS_DIR/bin/jarvis")" ]]
	}
	# The only check that opens the microphone, which is why it is behind a
	# flag: half a second of capture, and a file with something in it.
	#
	# « Something in it » used to mean a byte count, and that is how this
	# line stayed green through the whole of 2026-09-01 while the node it
	# names was muted: a muted capture is not a short file, it is a full one
	# made of zeros. So it counts what is NOT zero, exactly as do_finish
	# does — a check that cannot tell silence from sound is worse than none,
	# because it is the line a user reads to rule the microphone out.
	check_capture() {
		local out pid size
		out=$(mktemp) || return 1
		timeout 5 pw-record --target "$MIC_TARGET" --rate 16000 --channels 1 \
			--format s16 "$out" >/dev/null 2>&1 &
		pid=$!
		sleep 0.5
		# INT, like the pipeline: it is what makes pw-record finalize its
		# header instead of leaving a file nothing can read.
		kill -INT "$pid" 2>/dev/null
		wait "$pid" 2>/dev/null
		size=$(tr -d '\0' <"$out" 2>/dev/null | wc -c)
		rm -f "$out"
		((size > 64))
	}

	chk "claude (le cerveau)" bash -c 'command -v claude'
	chk "voxtype (l'oreille)" bash -c 'command -v "$1"' _ "$VOXTYPE"
	chk "pw-record" bash -c 'command -v pw-record'
	chk "pw-play" bash -c 'command -v pw-play'
	chk "piper : une synthèse réelle" check_piper
	chk "voix anglaise" test -f "$VOICE_EN"
	chk "micro ($MIC_TARGET) présent" bash -c 'pactl list sources short 2>/dev/null | grep -q "$1"' _ "$MIC_TARGET"
	((want_mic)) && chk "micro : capture réelle" check_capture
	chk "daemon wake (hey Jarvis)" wake_alive
	chk "venv wake + openwakeword" check_wake_venv
	chk "planches du poisson" check_sheets
	chk "poisson conforme à l'âme" check_look
	chk "greffon installé" test -d "$HOME/.config/omarchy/plugins/macarchy.jarvis"
	chk "unités systemd installées et actives" check_units
	chk "omarchy-jarvis pointe sur ce dépôt" check_symlink
	chk "boîte $BOX_DIR" test -d "$BOX_DIR/input/.work"
	chk "symlink memory" test "$(readlink -f "$BOX_DIR/memory" 2>/dev/null)" = "$(readlink -f "$MEMORY_DIR")"
	chk "settings.json valide" python3 -c "import json;json.load(open('$JARVIS_DIR/.claude/settings.json'))"
	chk "prompts (ronde, rêve, digestion)" bash -c "test -f '$MEMORY_DIR/HEARTBEAT_PROMPT.md' -a -f '$MEMORY_DIR/DREAM_PROMPT.md' -a -f '$MEMORY_DIR/DIGEST_PROMPT.md'"
	chk "connaissance à jour (omarchy)" test "$(omarchy version 2>/dev/null)" = "$(cat "$MEMORY_DIR/knowledge/VERSION" 2>/dev/null)"
	# The one line with a sentence instead of a label, because the answer is
	# a duration and the remedy is a command. The watchdog normally gets
	# there first; this is what shows when the pulse itself is not running,
	# which is the case where the user has been staring at a frozen fish.
	now_state=$(state) age=$(state_age)
	if [[ $now_state != idle ]] && ((age > 600)); then
		printf '✗ machine bloquée en « %s » depuis %s min (omarchy-jarvis cancel)\n' "$now_state" "$((age / 60))"
		fails=$((fails + 1))
	elif ((!quiet)); then
		printf '✓ état : %s\n' "$now_state"
	fi
	if ((!quiet)); then
		printf 'ℹ cerveau : %s — conversation : %s\n' \
			"$(brain_status)" "$([[ -e $CONV_FLAG ]] && echo "ouverte ($((($(date +%s) - $(stat -c %Y "$CONV_FLAG")) / 60)) min)" || echo fermée)"
		((fails)) && printf '%s problème(s).\n' "$fails"
	fi
	exit "$fails"
	;;
state)
	state
	;;
status)
	# Everything the Control Center's Jarvis page shows, one key=value per
	# line. Epochs are seconds; the panel does the arithmetic and wording.
	now=$(date +%s)
	last_hb=$(stat -c %Y "$STATE_DIR/last-heartbeat" 2>/dev/null || echo 0)
	last_ask=$(stat -c %Y "$LAST_ASK" 2>/dev/null || echo 0)
	# The next round: an hour after the last one, at least ten minutes
	# after the last exchange, on the mascot's five-minute pulse.
	next_hb=$((last_hb + 3600))
	((next_hb < last_ask + 600)) && next_hb=$((last_ask + 600))
	((next_hb < now)) && next_hb=$now
	printf 'state=%s\n' "$(state)"
	printf 'brain=%s\n' "$(brain_status)"
	printf 'quiet=%s\n' "$(quiet_now && echo oui || echo non)"
	printf 'rondes=%s\nreves=%s\nsilence=%s\n' "$(setting rondes oui)" "$(setting reves oui)" "$(setting silence 23-7)"
	# The key carries a hyphen in the soul and an underscore here: these
	# lines are read as `key=value` by the panel, and its parser splits on
	# the first `=` only — a hyphen would be fine, but every other key here
	# is already an identifier and consistency is worth more than the hyphen.
	printf 'micro_coupe=%s\n' "$(setting micro-coupe ecrire)"
	printf 'corps=%s\noeil=%s\ncriniere=%s\nqueue=%s\ncouleur=%s\n' "$(setting corps B1)" "$(setting oeil E1)" "$(setting criniere M1)" "$(setting queue T1)" "$(setting couleur or)"
	printf 'now=%s\nlast_ask_at=%s\nlast_heartbeat=%s\nnext_heartbeat=%s\nlast_dream=%s\n' \
		"$now" "$last_ask" "$last_hb" "$next_hb" "$(stat -c %Y "$STATE_DIR/last-dream" 2>/dev/null || echo 0)"
	printf 'last_ask=%s\n' "$(tr '\n' ' ' 2>/dev/null <"$LAST_ASK")"
	printf 'last_reply=%s\n' "$(tr '\n' ' ' 2>/dev/null <"$LAST_REPLY")"
	printf 'failures=%s\n' "$(grep '^- \[' "$FAILURES" 2>/dev/null | wc -l)"
	printf 'lessons=%s\n' "$(grep '^- ' "$MEMORY_DIR/LEARNED.md" 2>/dev/null | wc -l)"
	printf 'suggestions=%s\n' "$(grep '^- \[' "$SUGGESTIONS" 2>/dev/null | wc -l)"
	;;
suggestions)
	# The dream's proposals, one per line: `<n>\t<date>\t<text>` with the
	# indented continuation lines joined. `n` is the entry's rank in the
	# file, what `suggestion <n> …` acts on.
	awk '
		function flush() { if (t != "") print n "\t" d "\t" t; t = "" }
		/^- \[/ { flush(); n++; d = $0; sub(/^- \[/, "", d); sub(/\].*/, "", d)
		          t = $0; sub(/^- \[[^]]*\] */, "", t); next }
		n && /^  +[^ ]/ && t != "" { s = $0; sub(/^ +/, "", s); t = t " " s; next }
		{ flush() }
		END { flush() }' "$SUGGESTIONS" 2>/dev/null
	;;
suggestion)
	# `suggestion <n> accept` hands the entry to a background mission in
	# this repository and removes it; `suggestion <n> reject` just removes
	# it. Both leave a line in the journal — nothing disappears silently.
	n=${2:-} verb=${3:-}
	entry=$("$0" suggestions | awk -F'\t' -v n="$n" '$1 == n { print $3 }')
	if [[ -z $entry || $verb != accept && $verb != reject ]]; then
		echo "usage: jarvis suggestion <n> accept|reject" >&2
		exit 1
	fi
	awk -v n="$n" '/^- \[/ { k++ } !(k == n && (/^- \[/ || /^  +[^ ]/))' "$SUGGESTIONS" >"$SUGGESTIONS.tmp" &&
		mv "$SUGGESTIONS.tmp" "$SUGGESTIONS"
	if [[ $verb == accept ]]; then
		journal "suggestion confiée : « $entry »"
		trace "suggestion confiée : « $entry »"
		"$0" dispatch --dir "$JARVIS_DIR" "Une suggestion issue d'un de tes rêves (memory/SUGGESTIONS.md) vient d'être approuvée par l'utilisateur : « $entry ». Mets-la en œuvre dans ce dépôt (bin/, memory/*.md, CLAUDE.md, .claude/settings.json) de façon minimale et vérifiable ; si elle demande une décision humaine ou un accès que tu n'as pas, écris précisément ce qui manque dans memory/SUGGESTIONS.md plutôt que d'improviser."
	else
		journal "suggestion rejetée : « $entry »"
		trace "suggestion rejetée : « $entry »"
		notify "Jarvis" "Suggestion écartée."
	fi
	;;
*)
	echo "usage: jarvis [press|cancel [--say] [--from <mot>]|reset|settle|watchdog|ask [--quiet] <text>|say <text>|state|status|dispatch [--dir <dir>] <task>|dream [--quiet]|maybe-dream|heartbeat|tick|digest|doctor [--quiet] [--mic]|rotate|look [random]|lastcmd|missed [min]|save|greet|index|note <text>|noise? <text>|suggestions|suggestion <n> accept|reject]" >&2
	exit 1
	;;
esac
