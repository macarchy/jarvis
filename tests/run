#!/usr/bin/env bash
# tests/run — the offline test suite. A fake `claude`, a fake voice, a fake
# ear and a fake microphone (tests/bin) let the whole pipeline run in
# throwaway sandboxes: no quota, no network, no sound, no Touch Bar. Each
# test gets a fresh sandbox through the JARVIS_* overrides in bin/jarvis —
# RUN/STATE/MEMORY/BOX/SPRITES for the directories, PIPER/VOXTYPE for the
# two binaries of the voice path, NO_DESKTOP and WAKE for the two organs
# that live outside any sandbox.
set -u
TESTS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
JARVIS="$TESTS_DIR/../bin/jarvis"
FIX="$TESTS_DIR/fixtures"
export PATH="$TESTS_DIR/bin:$PATH"
pass=0 fail=0 current=""

# Every sandbox is remembered so the run leaves nothing behind: neither the
# mktemp trees (one per test, they used to pile up in /tmp) nor the real
# recorders and players a press leaves running on purpose.
sandboxes=()
cleanup() {
	local sb pidfile pgid
	for sb in ${sandboxes+"${sandboxes[@]}"}; do
		# Whole groups, the way bin/jarvis kills them: a bare pid would leave
		# the recorder holding the microphone behind its little session shell.
		for pidfile in "$sb"/run/pids/*; do
			pgid=$(cat "$pidfile" 2>/dev/null) || continue
			[[ -n $pgid ]] && kill -TERM "-$pgid" 2>/dev/null
		done
		rm -rf "$sb"
	done
}
trap cleanup EXIT

sandbox() {
	SB=$(mktemp -d)
	sandboxes+=("$SB")
	export JARVIS_RUN="$SB/run" JARVIS_STATE="$SB/state" \
		JARVIS_MEMORY="$SB/memory" JARVIS_BOX="$SB/box" \
		JARVIS_SPRITES="$SB/sprites" JARVIS_CLAUDE_PROJECTS="$SB/projects" \
		JARVIS_PIPER="$TESTS_DIR/bin/piper" JARVIS_VOXTYPE="$TESTS_DIR/bin/voxtype" \
		JARVIS_NO_DESKTOP=1 JARVIS_WAKE=0 \
		FAKE_CLAUDE_LOG="$SB/claude.log" FAKE_PIPER_LOG="$SB/piper.log" \
		FAKE_PLAY_LOG="$SB/play.log" FAKE_SHELL_LOG="$SB/shell.log" \
		FAKE_VOXTYPE_LOG="$SB/voxtype.log" FAKE_NOTIFY_LOG="$SB/notify.log" \
		FAKE_PACTL_LOG="$SB/pactl.log"
	# The soul lives in the repository, not in the sandbox — so a test that
	# has not asked for one of its own must never inherit the doctored copy
	# left exported by the previous test.
	unset JARVIS_SOUL
	mkdir -p "$JARVIS_RUN" "$JARVIS_STATE" "$JARVIS_MEMORY/knowledge"
	cp "$TESTS_DIR"/../memory/*_PROMPT.md "$JARVIS_MEMORY/"
	echo test >"$JARVIS_MEMORY/knowledge/VERSION"
	: >"$FAKE_CLAUDE_LOG"
	# a non-idle state keeps digest from trying to speak
	printf 'thinking' >"$JARVIS_RUN/state"
}

t() { current="$1"; sandbox; }

# A failing assertion says what it saw: the last lines the command printed
# and the sandbox it printed them in, which survives long enough to look at
# only if the run is interrupted — so print the path either way.
assert() {
	local desc="$1" out rc
	shift
	out=$("$@" 2>&1)
	rc=$?
	if ((rc == 0)); then
		pass=$((pass + 1))
	else
		fail=$((fail + 1))
		printf '✗ %s — %s\n' "$current" "$desc"
		[[ -n $out ]] && printf '%s\n' "$out" | tail -3 | sed 's/^/    │ /'
		printf '    └ %s\n' "$SB"
	fi
}
today() { date +%F; }
journal_has() { grep -q "$1" "$JARVIS_MEMORY/journal/$(today).md"; }
# « Pas d'échec noté » : le fichier existe toujours — memory_init lui rend
# son en-tête au premier lancement — donc la question est s'il porte une
# entrée, pas s'il est là.
no_aborts() { ! grep -q '^- \[' "$JARVIS_MEMORY/ABORTS.md" 2>/dev/null; }
no_failures() { ! grep -q '^- \[' "$JARVIS_MEMORY/FAILURES.md" 2>/dev/null; }
state_is() { [[ $(cat "$JARVIS_RUN/state" 2>/dev/null) == "$1" ]]; }
# A pid we never got is neither alive nor dead: both answers stay false so
# a missing pid file can never be mistaken for a process that behaved.
alive() { [[ -n ${1:-} ]] && kill -0 "$1" 2>/dev/null; }
dead() { [[ -n ${1:-} ]] && ! kill -0 "$1" 2>/dev/null; }
# The pipeline's stages are real processes: give them up to two seconds
# rather than racing them.
waitfor() {
	local i
	for ((i = 0; i < 40; i++)); do
		"$@" >/dev/null 2>&1 && return 0
		sleep 0.05
	done
	return 1
}
# The FSM refuses a press within 250 ms of the last transition — the button
# and the wake daemon's silence timer firing together are one gesture, not
# two — so a test that presses again has to let the dead time pass.
pressable() { sleep 0.3; }
# The recorder arms its signal handlers before it creates the WAV, so the
# file appearing is what says "you may press again": a SIGINT sent earlier
# is lost, exactly as it would be against a real recorder still starting.
# The dead time above is part of that same permission.
mic_ready() {
	waitfor test -e "$JARVIS_RUN/utterance.wav" &&
		waitfor state_is listening && pressable
}
# Un bac à sable où la machine n'a jamais bougé n'a pas de journal, et c'est
# une réponse valide — « aucun état traversé » — pas une erreur à afficher.
states_seen() { sed -n 's/^[^ ]* state: //p' "$JARVIS_STATE/jarvis.log" 2>/dev/null | paste -sd' ' -; }
# `assert` runs its command through "$@", and `!` is a shell keyword rather
# than a command — so a negated expectation needs a real one to run.
not() { ! "$@"; }
journal_lacks() { ! journal_has "$1"; }
# A soul of one's own, for the settings a test needs to vary. The real one
# lives in the repository rather than the sandbox, so JARVIS_SOUL moves it
# for the length of a test exactly as JARVIS_RUN moves the state.
soul_with() {
	sed "/^- langue:/a - $1" "$TESTS_DIR/../SOUL.md" >"$SB/SOUL.md"
	export JARVIS_SOUL="$SB/SOUL.md"
}

# The conversation as the CLI stores it: a transcript per session under the
# project's directory (its path with / turned into -). `with_session` drops
# the fixture there and makes it the live conversation.
SESSION=11111111-2222-3333-4444-555555555555
project_dir() { printf '%s/%s' "$JARVIS_CLAUDE_PROJECTS" "$(realpath "$TESTS_DIR/.." | tr / -)"; }
with_session() {
	mkdir -p "$(project_dir)"
	cp "$FIX/session.jsonl" "$(project_dir)/$SESSION.jsonl"
	printf '%s' "$SESSION" >"$JARVIS_STATE/conversation"
}

# ---- the scripts themselves parse
t "hygiène : tout s'analyse avant de tourner"
assert "bash -n bin/jarvis" bash -n "$JARVIS"
assert "bash -n bin/jarvis-fsm.sh" bash -n "$TESTS_DIR/../bin/jarvis-fsm.sh"
assert "bash -n bin/jarvis-wake" bash -n "$TESTS_DIR/../bin/jarvis-wake"
assert "bash -n install.sh" bash -n "$TESTS_DIR/../install.sh"
assert "bash -n bootstrap.sh" bash -n "$TESTS_DIR/../bootstrap.sh"
assert "python compile" env PYTHONPYCACHEPREFIX="$SB/pyc" python3 -m py_compile \
	"$TESTS_DIR/../bin/jarvis-sentences" "$TESTS_DIR/../bin/jarvis-index" \
	"$TESTS_DIR/../bin/jarvis-wake.py" "$TESTS_DIR/../bin/jarvis_wake_fsm.py"
# ShellCheck is not part of the toolchain here; run it when it happens to be.
# (Capital S deliberately: a comment opening with the lowercase name is read
#  as a directive, and an unparseable directive stops the whole file.)
command -v shellcheck >/dev/null && {
	assert "shellcheck bin/jarvis" shellcheck -S warning -x "$JARVIS"
	assert "shellcheck bin/jarvis-fsm.sh" shellcheck -S warning "$TESTS_DIR/../bin/jarvis-fsm.sh"
}

# ---- a fresh clone has no memory, and must not stay that way
t "mémoire : un clone frais retrouve ses en-têtes, vides"
"$JARVIS" state >/dev/null
for name in LEARNED CONVERSATION FAILURES ABORTS SUGGESTIONS; do
	assert "$name.md restauré" test -e "$JARVIS_MEMORY/$name.md"
	assert "$name.md a son en-tête" grep -q "^# $name.md" "$JARVIS_MEMORY/$name.md"
done
# Restauré veut dire vide : un gabarit qui apporterait des leçons ou des
# suggestions toutes faites ferait démarrer chaque installation avec la
# mémoire de quelqu'un d'autre.
assert "aucune leçon héritée" test "$(grep -c '^- ' "$JARVIS_MEMORY/LEARNED.md")" = 0
assert "aucune suggestion héritée" test "$(grep -c '^- \[' "$JARVIS_MEMORY/SUGGESTIONS.md")" = 0
# Et il ne réécrit jamais par-dessus ce qui existe.
printf -- '- une leçon à moi\n' >>"$JARVIS_MEMORY/LEARNED.md"
"$JARVIS" state >/dev/null
assert "la mémoire existante est intacte" grep -q 'une leçon à moi' "$JARVIS_MEMORY/LEARNED.md"

# ---- jarvis-sentences: blocks stay separated across tool calls
t "sentences: espaces entre blocs"
out="$SB/reply"
"$TESTS_DIR/../bin/jarvis-sentences" "$out.txt" <"$FIX/blocks.jsonl" >"$SB/spoken"
assert "texte complet espacé" test "$(cat "$out.txt")" = "Je fais ma ronde. Un instant. RAS"
assert "et dit phrase par phrase" \
	test "$(paste -sd'|' "$SB/spoken")" = "Je fais ma ronde.|Un instant.|RAS"
assert "la trace reste dans le bac à sable" \
	grep -q '→ Bash: df -h /' "$JARVIS_MEMORY/trace/$(today).log"
assert "le verdict de session est ok" test "$(cat "$out.txt.status")" = ok

# Le cerveau met du gras malgré l'âme (« 1. **work-cd** », 2026-09-02) et
# piper lit chaque astérisque : « astérisque astérisque work-cd astérisque
# astérisque ». Les marques markdown s'arrêtent avant la voix.
t "sentences: le markdown ne se prononce pas"
out="$SB/reply"
"$TESTS_DIR/../bin/jarvis-sentences" "$out.txt" <"$FIX/bold.jsonl" >"$SB/spoken"
assert "phrases sans astérisque ni tilde" \
	test "$(paste -sd'|' "$SB/spoken")" = "Trois sessions : 1. work-cd en attente.|Celle-ci, c'est jarvis, pas work."
# Le même échange coupait après « 1. » : « un. », une pause, « work-cd ».
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"Deux choses : 1. le disque est plein. 2. Le Wi-Fi est coupé. Il est 10 h. Ça va ?"}]}}' '{"type":"result","subtype":"success","is_error":false}' |
	"$TESTS_DIR/../bin/jarvis-sentences" "$out.txt" >"$SB/spoken"
assert "un numéro de liste n'est pas une fin de phrase" \
	test "$(paste -sd'|' "$SB/spoken")" = "Deux choses : 1. le disque est plein.|2. Le Wi-Fi est coupé.|Il est 10 h.|Ça va ?"
printf 'idle' >"$JARVIS_RUN/state"
"$JARVIS" say "C'est **gras**, non ?"
assert "say : la voix reçoit le texte nu" grep -q $'\tC\'est gras, non ?$' "$FAKE_PIPER_LOG"

# En mode --quiet le fichier est le RAPPORT — le dernier bloc de texte — et
# non la narration qui l'a précédé. Chaque ronde revenait « Je fais ma
# ronde. Un instant. RAS », et un rapport qui n'est pas exactement « RAS »
# est un constat : huit rondes du 2026-09-01 ont été journalisées, notifiées
# et inquiétées pour avoir, en somme, dit qu'il n'y avait rien.
t "sentences: en --quiet, le dernier bloc est le rapport"
"$TESTS_DIR/../bin/jarvis-sentences" --quiet "$out.txt" <"$FIX/blocks.jsonl"
assert "le rapport est le dernier bloc" test "$(cat "$out.txt")" = "RAS"
# Un verdict périmé ne survit pas au lancement suivant.
printf 'quota' >"$out.txt.error"
"$TESTS_DIR/../bin/jarvis-sentences" --quiet "$out.txt" <"$FIX/ras.jsonl"
assert "un .error périmé est effacé au départ" test ! -e "$out.txt.error"

# Une phrase qui clôt un bloc de texte est complète sans espace derrière
# elle. Elle restait dans le tampon jusqu'à l'ouverture du bloc SUIVANT,
# c'est-à-dire après l'outil : « Un instant. » censé couvrir l'attente
# arrivait l'attente finie. Ici le flux est coupé en deux par une pause,
# et la première phrase doit être sortie avant que la suite n'arrive.
t "sentences: une phrase de narration sort avant que l'outil ne rende"
: >"$SB/spoken"
{
	head -n 3 "$FIX/narration.jsonl"
	sleep 0.6
	tail -n +4 "$FIX/narration.jsonl"
} | "$TESTS_DIR/../bin/jarvis-sentences" "$out.txt" >"$SB/spoken" &
sentences=$!
sleep 0.3
assert "la narration est déjà dite pendant l'outil" \
	test "$(cat "$SB/spoken")" = "Je regarde."
wait "$sentences"
assert "puis la réponse" \
	test "$(paste -sd'|' "$SB/spoken")" = "Je regarde.|Le disque est à huit pour cent."

# ---- heartbeat
t "heartbeat: RAS reste silencieux"
FAKE_CLAUDE_STREAM="$FIX/ras.jsonl" "$JARVIS" heartbeat
assert "cerveau ok" test "$(cat "$JARVIS_STATE/brain")" = ok
assert "pas de ligne ronde au journal" bash -c "! grep -q 'ronde :' '$JARVIS_MEMORY/journal/$(today).md' 2>/dev/null"

t "heartbeat: un rapport est journalisé"
FAKE_CLAUDE_STREAM="$FIX/report.jsonl" "$JARVIS" heartbeat
assert "journal ronde" journal_has "ronde : Le disque est presque plein."

# Le constat vu huit fois le 2026-09-01 : la ronde se raconte (« Je fais ma
# ronde. Un instant. »), lance ses outils, puis conclut « RAS » — et la
# narration collée devant faisait de « RAS » un rapport à signaler.
t "heartbeat: une ronde qui se raconte avant de dire RAS reste silencieuse"
FAKE_CLAUDE_STREAM="$FIX/blocks.jsonl" "$JARVIS" heartbeat
assert "cerveau ok" test "$(cat "$JARVIS_STATE/brain")" = ok
assert "pas de ligne ronde au journal" journal_lacks "ronde :"
assert "pas d'inquiétude garée" test ! -e "$JARVIS_STATE/emote-pending"

# Une limite atteinte APRÈS un début de réponse est encore une limite : le
# verdict vient de l'événement de fin, pas des mots qui l'ont précédé.
t "heartbeat: une limite après un début de ronde est un quota, pas un rapport"
FAKE_CLAUDE_STREAM="$FIX/partial-then-limit.jsonl" "$JARVIS" heartbeat
assert "statut quota" bash -c "grep -q '^quota ' '$JARVIS_STATE/brain'"
assert "la narration n'est pas journalisée comme une ronde" journal_lacks "ronde :"

t "heartbeat: l'avis de quota n'atteint pas la bulle"
FAKE_CLAUDE_STREAM="$FIX/quota.jsonl" "$JARVIS" heartbeat
rc=$?
assert "exit non nul" test "$rc" != 0
assert "statut quota" bash -c "grep -q '^quota ' '$JARVIS_STATE/brain'"
assert "journal en français" journal_has "quota atteint"
assert "pas de ronde journalisée" bash -c "! grep -q 'ronde :' '$JARVIS_MEMORY/journal/$(today).md'"

# ---- digest
t "digest: succès de bout en bout"
echo "document" >"$JARVIS_BOX-seed"; mkdir -p "$JARVIS_BOX/input"; mv "$JARVIS_BOX-seed" "$JARVIS_BOX/input/doc.md"
FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" FAKE_CLAUDE_FICHE=1 "$JARVIS" digest
assert "fiche écrite" bash -c "ls '$JARVIS_MEMORY/knowledge/inbox/'*-doc.md"
assert "original archivé" test -e "$JARVIS_BOX/input/.archive/doc.md"
assert "journal digestion" journal_has "digestion : doc.md"
assert "index inbox régénéré" bash -c "grep -q 'Fiche de test' '$JARVIS_MEMORY/knowledge/inbox/INDEX.md'"
assert "confinement demandé" bash -c "grep -q -- '--disallowedTools Bash' '$FAKE_CLAUDE_LOG'"

t "digest: le quota gare sans appeler le cerveau"
printf 'quota %s' "$(( $(date +%s) + 3600 ))" >"$JARVIS_STATE/brain"
mkdir -p "$JARVIS_BOX/input"; echo x >"$JARVIS_BOX/input/doc.md"
"$JARVIS" digest
assert "fichier en .pending" test -e "$JARVIS_BOX/input/.pending/doc.md"
assert "compteur à 0" test "$(cat "$JARVIS_BOX/input/.pending/.tries.doc.md")" = 0
assert "aucun appel cerveau" test ! -s "$FAKE_CLAUDE_LOG"

t "digest: cerveau muet → gare sans compter d'essai"
mkdir -p "$JARVIS_BOX/input"; echo x >"$JARVIS_BOX/input/doc.md"
FAKE_CLAUDE_STREAM="$FIX/empty.jsonl" "$JARVIS" digest
assert "fichier en .pending" test -e "$JARVIS_BOX/input/.pending/doc.md"
assert "compteur intact" test "$(cat "$JARVIS_BOX/input/.pending/.tries.doc.md")" = 0
assert "statut down" test "$(cat "$JARVIS_STATE/brain")" = down

# Un échec réel : le cerveau a répondu, et il n'y a pas de fiche — c'est
# le document qui ne donne rien, et ça se compte.
t "digest: trois échecs réels → .failed"
mkdir -p "$JARVIS_BOX/input"; echo x >"$JARVIS_BOX/input/doc.md"
for _ in 1 2 3; do FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" "$JARVIS" digest; done
assert "fichier en .failed" test -e "$JARVIS_BOX/input/.failed/doc.md"
assert "échec noté" bash -c "grep -q 'abandonnée après 3 essais' '$JARVIS_MEMORY/FAILURES.md'"

# Une erreur de connexion n'est pas la faute du document : elle gare sans
# compter, et le cerveau est dit injoignable. Elle comptait comme un essai
# parce que « API connection error » ne ressemble à aucune limite connue —
# le texte votait, alors que l'événement de fin avait déjà dit « erreur ».
t "digest: une erreur de session gare sans compter d'essai"
mkdir -p "$JARVIS_BOX/input"; echo x >"$JARVIS_BOX/input/doc.md"
FAKE_CLAUDE_STREAM="$FIX/digest-error.jsonl" "$JARVIS" digest
rc=$?
assert "fichier en .pending" test -e "$JARVIS_BOX/input/.pending/doc.md"
assert "compteur intact" test "$(cat "$JARVIS_BOX/input/.pending/.tries.doc.md")" = 0
assert "statut down" test "$(cat "$JARVIS_STATE/brain")" = down
# Garer n'est pas échouer : systemd filait chaque tel passage en « Failed
# to start Jarvis inbox digestion » parce que l'arithmétique du dernier
# `((digested)) && …` servait de code de sortie.
assert "et le passage sort à zéro" test "$rc" = 0

# Le cerveau se prend pour son sujet : un article sur le rate limit d'une
# API, digéré correctement, convainquait brain_check qu'il était hors quota
# — l'autonomie s'arrêtait une heure et le document repassait à chaque
# pulsation. Le verdict vient de l'événement de fin, pas des mots.
t "digest: parler de rate limit n'est pas en subir un"
mkdir -p "$JARVIS_BOX/input"; echo x >"$JARVIS_BOX/input/api.md"
FAKE_CLAUDE_STREAM="$FIX/rate-limit-article.jsonl" FAKE_CLAUDE_FICHE=1 "$JARVIS" digest
assert "original archivé" test -e "$JARVIS_BOX/input/.archive/api.md"
assert "cerveau toujours ok" test "$(cat "$JARVIS_STATE/brain")" = ok

# ---- ask --quiet
t "ask --quiet: répond sans voix"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" "$JARVIS" ask --quiet "test écrit"
assert "réponse enregistrée" test "$(cat "$JARVIS_RUN/last-reply")" = "J'ai retenu la fondue."
assert "état revenu à idle" test "$(cat "$JARVIS_RUN/state")" = idle
assert "échange journalisé" journal_has "échange : « test écrit »"
assert "aucun wav synthétisé" test ! -s "$FAKE_PIPER_LOG"

# ---- the one button, end to end
t "press: idle → listening, le micro tourne vraiment"
printf 'idle' >"$JARVIS_RUN/state"
"$JARVIS" press
# Before anything is waited for: the handle exists the moment `press` returns,
# because it is reserved in the foreground and not by the recorder a fork
# later. An abort landing in that fork used to find nothing to kill.
assert "la poignée est réservée avant que l'oreille s'ouvre" test -e "$JARVIS_RUN/pids/record"
mic_ready
assert "état listening" state_is listening
assert "groupe enregistré" waitfor test -s "$JARVIS_RUN/pids/record"
rec=$(cat "$JARVIS_RUN/pids/record" 2>/dev/null)
assert "enregistreur vivant" alive "$rec"
assert "le poisson suit" grep -q 'macarchy.jarvis setState listening' "$FAKE_SHELL_LOG"
"$JARVIS" cancel
assert "état idle" state_is idle
assert "enregistreur arrêté" waitfor dead "$rec"

t "press: la séquence complète jusqu'à la fenêtre de relance"
export JARVIS_WAKE=1
printf 'idle' >"$JARVIS_RUN/state"
"$JARVIS" press
mic_ready
FAKE_TRANSCRIPT="quelle heure est-il" FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" "$JARVIS" press
assert "états traversés dans l'ordre" \
	test "$(states_seen)" = "listening transcribing thinking speaking followup"
assert "langue épinglée depuis l'âme" grep -q 'language = "fr"' "$JARVIS_RUN/voxtype.toml"
assert "transcript entendu" grep -q 'heard: quelle heure est-il' "$JARVIS_STATE/jarvis.log"
assert "réponse synthétisée en français" grep -q "fr_FR.*J'ai retenu la fondue." "$FAKE_PIPER_LOG"
assert "jouée en état speaking" grep -q ' speaking$' "$FAKE_PLAY_LOG"
assert "échange journalisé" journal_has "échange : « quelle heure est-il »"
"$JARVIS" settle
assert "le silence referme la fenêtre" state_is idle

# ---- la voix française est un réglage, pas une constante
#
# Les trois modèles n'ont pas la même licence : siwis est CC-BY 4.0, tom est
# AGPL-3.0. Le défaut doit donc être le permissif — personne ne devrait avoir
# à lire de l'AGPL pour installer un assistant vocal — et tom doit rester un
# choix qu'on écrit, jamais celui qu'on obtient en ne choisissant pas.
t "voix : l'âme choisit, et l'absence de choix donne la licence permissive"
soul="$SB/soul.md"
printf 'idle' >"$JARVIS_RUN/state"
printf -- '- langue: fr\n' >"$soul"
JARVIS_SOUL="$soul" "$JARVIS" say "Voilà, c'est fait."
assert "sans réglage : siwis" grep -q 'fr_FR-siwis' "$FAKE_PIPER_LOG"
assert "et surtout pas tom" not grep -q 'fr_FR-tom' "$FAKE_PIPER_LOG"

: >"$FAKE_PIPER_LOG"
printf -- '- langue: fr\n- voix: tom\n' >"$soul"
JARVIS_SOUL="$soul" "$JARVIS" say "Voilà, c'est fait."
assert "un choix explicite est respecté" grep -q 'fr_FR-tom' "$FAKE_PIPER_LOG"

: >"$FAKE_PIPER_LOG"
printf -- '- langue: fr\n- voix: gargamel\n' >"$soul"
JARVIS_SOUL="$soul" "$JARVIS" say "Voilà, c'est fait."
assert "une valeur inconnue retombe sur le défaut" grep -q 'fr_FR-siwis' "$FAKE_PIPER_LOG"

: >"$FAKE_PIPER_LOG"
printf -- '- langue: en\n' >"$soul"
JARVIS_SOUL="$soul" "$JARVIS" say "Right away, sir."
assert "l'anglais a la sienne" grep -q 'en_GB-alan' "$FAKE_PIPER_LOG"

# ---- la langue est un réglage, plus une devinette
#
# `langue` est une rangée de pastilles dans le Control Center, et le même
# réglage épingle déjà les oreilles : il dit dans quelle langue se tient la
# conversation. Ce que l'utilisateur a choisi doit donc gagner contre tout ce
# que le texte peut suggérer — la devinette ne survit que sous `auto`, où il
# n'y a rien à obéir.
t "langue : le réglage décide de la voix, pas l'orthographe de la phrase"
printf 'idle' >"$JARVIS_RUN/state"

: >"$FAKE_PIPER_LOG"
printf -- '- langue: fr\n' >"$soul"
JARVIS_SOUL="$soul" "$JARVIS" say "Right away, sir."
assert "épinglé en français, une phrase anglaise garde la voix française" \
	grep -q 'fr_FR-siwis' "$FAKE_PIPER_LOG"
assert "et ne touche jamais la voix anglaise" not grep -q 'en_GB-alan' "$FAKE_PIPER_LOG"

: >"$FAKE_PIPER_LOG"
printf -- '- langue: en\n' >"$soul"
JARVIS_SOUL="$soul" "$JARVIS" say "Voilà, c'est fait."
assert "épinglé en anglais, une phrase française garde la voix anglaise" \
	grep -q 'en_GB-alan' "$FAKE_PIPER_LOG"

# Sous `auto` il devine encore, parce qu'il n'a rien d'autre. C'est
# exactement pourquoi le réglage existe.
: >"$FAKE_PIPER_LOG"
printf -- '- langue: auto\n' >"$soul"
JARVIS_SOUL="$soul" "$JARVIS" say "Voilà, c'est fait."
assert "auto : une phrase accentuée part en français" grep -q 'fr_FR-siwis' "$FAKE_PIPER_LOG"
: >"$FAKE_PIPER_LOG"
JARVIS_SOUL="$soul" "$JARVIS" say "Right away, sir."
assert "auto : une phrase anglaise part en anglais" grep -q 'en_GB-alan' "$FAKE_PIPER_LOG"

# Les phrases qu'aucun modèle n'a écrites suivent le même réglage. Sinon la
# voix anglaise lit du français, ce qui s'entend exactement comme ça se lit.
: >"$FAKE_PIPER_LOG"
printf -- '- langue: en\n' >"$soul"
printf 'thinking' >"$JARVIS_RUN/state"
JARVIS_SOUL="$soul" "$JARVIS" cancel --say --from test
assert "l'annulation se dit en anglais" grep -q 'Cancelled' "$FAKE_PIPER_LOG"
assert "et pas en français" not grep -q 'Annulé' "$FAKE_PIPER_LOG"

# Le vrai défaut que ce réglage supprime. La voix était choisie phrase par
# phrase : deux des trois phrases de cette réponse française n'ont ni accent
# ni mot-outil de la liste, et partaient donc en anglais — au milieu d'une
# réponse dont la première phrase était déjà sortie en français. Une réponse
# qui change d'accent en route est pire qu'une réponse dite en entier dans
# la mauvaise langue : la première s'entend comme une panne.
t "une réponse, une voix : l'accent ne change pas en cours de route"
printf 'idle' >"$JARVIS_RUN/state"
: >"$FAKE_PIPER_LOG"
printf -- '- langue: auto\n' >"$soul"
JARVIS_SOUL="$soul" FAKE_CLAUDE_STREAM="$FIX/mixed-lang.jsonl" \
	"$JARVIS" ask "où en est mon disque"
assert "les trois phrases sont dites" test "$(grep -c . "$FAKE_PIPER_LOG")" = 3
assert "toutes par la même voix" \
	test "$(cut -f1 "$FAKE_PIPER_LOG" | sort -u | wc -l)" = 1
assert "et c'est la française, décidée sur la première phrase" \
	grep -q 'fr_FR-siwis' "$FAKE_PIPER_LOG"

t "presser et annuler ensemble : le micro ne reste pas ouvert derrière"
printf 'idle' >"$JARVIS_RUN/state"
# The abort arrives after the press has taken the machine and before the
# recorder exists — the window that used to leave the microphone open for the
# rest of the session with nothing on disk to close it by. FAKE_PACTL_SLEEP
# holds the press exactly there, so this is a moment and not a race.
FAKE_PACTL_SLEEP=1 "$JARVIS" press &
presser=$!
assert "la machine est prise" waitfor state_is listening
"$JARVIS" cancel
wait "$presser" 2>/dev/null
assert "état idle" state_is idle
assert "aucune poignée abandonnée" test ! -e "$JARVIS_RUN/pids/record"
# The recorder creates the WAV as its first act and the abort removed it, so
# the file coming back is the ear opening behind the abort — the whole bug,
# and a witness that cannot be confused with the process asking about it.
sleep 0.2
assert "et l'oreille ne s'est pas rouverte derrière" test ! -e "$JARVIS_RUN/utterance.wav"

t "press: sans audio, retour immédiat à idle"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_RECORD_SILENT=1 "$JARVIS" press
mic_ready
assert "en écoute" state_is listening
"$JARVIS" press
assert "état idle" state_is idle
assert "aucun appel cerveau" test ! -s "$FAKE_CLAUDE_LOG"

t "press: transcript vide → échec noté, retour à idle"
printf 'idle' >"$JARVIS_RUN/state"
"$JARVIS" press
mic_ready
FAKE_TRANSCRIPT="" "$JARVIS" press
assert "échec noté" grep -q "transcript vide" "$JARVIS_MEMORY/FAILURES.md"
assert "excuse dite à voix haute" grep -q "Je n'ai rien entendu." "$FAKE_PIPER_LOG"
assert "état idle" state_is idle
assert "aucun appel cerveau" test ! -s "$FAKE_CLAUDE_LOG"

# ---- le micro qui n'est pas là
#
# Le 2026-09-01 à 23:07 : micro coupé, et il a quand même pris l'air
# d'écouter — le poisson, « J'écoute… », cinq secondes d'enregistrement —
# puis whisper a rendu le générique Amara et il l'a dit à voix haute.
# Faire semblant d'écouter est le défaut ; l'hallucination n'est que ce
# qui en sort.
t "micro coupé : il tend le clavier au lieu de faire semblant d'écouter"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_MIC_MUTED=1 "$JARVIS" press
assert "il n'est jamais passé en écoute" test "$(states_seen)" = ""
assert "état idle" state_is idle
assert "aucun micro ouvert" test ! -e "$JARVIS_RUN/utterance.wav"
assert "aucune poignée réservée" test ! -e "$JARVIS_RUN/pids/record"
assert "la barre de saisie s'ouvre" grep -q 'macarchy.jarvis prompt' "$FAKE_SHELL_LOG"
assert "il dit pourquoi" grep -qi 'micro' "$FAKE_NOTIFY_LOG"
# Couper son micro est un geste délibéré : il ne le défait jamais de
# lui-même, et c'est le journal des écritures pactl qui en témoigne.
assert "il ne réactive rien tout seul" test ! -s "$FAKE_PACTL_LOG"
assert "aucun appel cerveau" test ! -s "$FAKE_CLAUDE_LOG"
assert "ce n'est pas une panne" no_failures

t "micro coupé : le mode prevenir se contente de dire pourquoi"
printf 'idle' >"$JARVIS_RUN/state"
soul_with "micro-coupe: prevenir"
FAKE_MIC_MUTED=1 "$JARVIS" press
assert "il dit pourquoi" grep -qi 'micro' "$FAKE_NOTIFY_LOG"
assert "aucune barre de saisie" not grep -q 'macarchy.jarvis prompt' "$FAKE_SHELL_LOG"
assert "il n'est jamais passé en écoute" test "$(states_seen)" = ""
assert "aucun micro ouvert" test ! -e "$JARVIS_RUN/utterance.wav"

t "micro coupé : le mode reactiver le rouvre, le dit, et écoute pour de bon"
printf 'idle' >"$JARVIS_RUN/state"
soul_with "micro-coupe: reactiver"
FAKE_MIC_MUTED=1 "$JARVIS" press
assert "le micro est réactivé" grep -q 'set-source-mute .* 0' "$FAKE_PACTL_LOG"
assert "il l'annonce" grep -qi 'micro' "$FAKE_NOTIFY_LOG"
mic_ready
assert "et il écoute vraiment" state_is listening
"$JARVIS" cancel

# Le Control Center lit les réglages dans `status`, pas dans l'âme : c'est
# par là que le sélecteur du panneau connaît le mode courant.
t "status : le mode « micro coupé » est publié pour le Control Center"
soul_with "micro-coupe: prevenir"
"$JARVIS" status >"$SB/status.out"
assert "le mode courant est publié" grep -q '^micro_coupe=prevenir' "$SB/status.out"

# Un micro ouvert mais mort — jack débranché, graphe cassé, gain à zéro —
# rend un WAV bien dodu qui n'est que des zéros. Mesuré : 30 octets non
# nuls sur 78 ko de capture muette, contre 66 819 pour une vraie pièce
# silencieuse. Whisper n'a rien à faire là-dedans.
t "capture muette : whisper n'est jamais appelé"
printf 'idle' >"$JARVIS_RUN/state"
printf 'une vraie question' >"$JARVIS_RUN/last-ask"
FAKE_RECORD_ZEROS=1 "$JARVIS" press
mic_ready
"$JARVIS" press
assert "l'oreille n'a pas été dérangée" test ! -s "$FAKE_VOXTYPE_LOG"
assert "aucun appel cerveau" test ! -s "$FAKE_CLAUDE_LOG"
assert "il le dit" grep -qi "rien entendu" "$FAKE_NOTIFY_LOG"
assert "état idle" state_is idle
assert "la dernière question n'a pas bougé" \
	test "$(cat "$JARVIS_RUN/last-ask")" = "une vraie question"

# ---- ce qu'il entend n'est pas toujours quelqu'un
#
# Whisper answers silence with the subtitle credits it was trained on, and
# that string used to reach the brain, the speakers and the journal as a
# real question — nine times on 2026-09-01. The empty-transcript guard above
# never fires on it: whisper does not return nothing, it returns boilerplate.
t "bruit : une hallucination de sous-titres n'atteint ni le cerveau ni la voix"
printf 'idle' >"$JARVIS_RUN/state"
printf 'une vraie question' >"$JARVIS_RUN/last-ask"
"$JARVIS" press
mic_ready
FAKE_TRANSCRIPT="Sous-titres réalisés par la communauté d'Amara.org" "$JARVIS" press
assert "aucun appel cerveau" test ! -s "$FAKE_CLAUDE_LOG"
assert "rien n'est dit à voix haute" test ! -s "$FAKE_PIPER_LOG"
assert "état idle" state_is idle
assert "journalisé comme bruit" grep -q "noise: Sous-titres" "$JARVIS_STATE/jarvis.log"
assert "aucun échange au journal" journal_lacks "Amara"
# Le point crucial : une hallucination poussait $LAST_ASK en avant, et la
# ronde suivante se croyait alors de trop pendant dix minutes.
assert "la dernière question n'a pas bougé" \
	test "$(cat "$JARVIS_RUN/last-ask")" = "une vraie question"
# Ce n'est pas une panne : rien à distiller en leçon, rien à programmer en rêve.
assert "aucun échec noté" no_failures

t "bruit : la table entière se teste sans audio"
assert "le générique Amara" "$JARVIS" noise? "Sous-titres réalisés par la communauté d'Amara.org"
assert "l'appel à l'abonnement" "$JARVIS" noise? "Je vous invite à vous abonner à la chaîne."
assert "le remerciement de fin de vidéo" "$JARVIS" noise? "Merci d'avoir regardé cette vidéo !"
assert "Sous-titrage Société Radio-Canada" "$JARVIS" noise? "Sous-titrage Société Radio-Canada"
assert "SousTitreur.com" "$JARVIS" noise? "SousTitreur.com"
assert "Thanks for watching" "$JARVIS" noise? "Thanks for watching!"
assert "un merci seul" "$JARVIS" noise? "Merci."
assert "un « you » seul" "$JARVIS" noise? "you"
assert "de la ponctuation seule" "$JARVIS" noise? " ... "
assert "une chaîne vide" "$JARVIS" noise? ""
# Les négatifs comptent autant : un filtre qui mange une vraie demande est
# pire que l'hallucination qu'il attrape.
assert "une vraie demande passe" not "$JARVIS" noise? "Verrouille mon ordinateur."
assert "un merci dans une phrase passe" not "$JARVIS" noise? "Merci, tu peux éteindre le wifi ?"
assert "une question sur les sous-titres passe" \
	not "$JARVIS" noise? "Trouve-moi les sous-titres de ce film."

# ---- the conversation, read as it is stored
t "transcript : les derniers échanges, avec ce qu'il a pensé et fait"
with_session
"$JARVIS" transcript 1 >"$SB/t1"
assert "le dernier échange" grep -q '^10:05 « Et la météo ? »' "$SB/t1"
assert "sa réponse" grep -q '^  ⇒ Nuageux, dix-huit degrés.' "$SB/t1"
assert "une réflexion vide (Sonnet) n'est pas montrée" not grep -q '✎' "$SB/t1"
"$JARVIS" transcript >"$SB/t5"
assert "la réflexion de Haiku" grep -q '^  ✎ Il demande l'"'"'heure, je lance date.' "$SB/t5"
assert "l'appel d'outil" grep -q '^  → Bash: date +%H:%M' "$SB/t5"
assert "son résultat" grep -q '^  ← 10:00' "$SB/t5"
assert "deux échanges en JSON" \
	test "$("$JARVIS" transcript --json | python3 -c 'import json,sys; x=json.load(sys.stdin); print(len(x), x[0]["tools"][0]["result"], x[1]["thoughts"])')" = "2 10:00 []"

t "conversations : la liste, la courante marquée, les rondes à part"
with_session
# A round: one session opened on a prompt of several hundred characters.
python3 - "$(project_dir)/22222222-0000-0000-0000-000000000000.jsonl" <<'PY'
import json, sys
S = "22222222-0000-0000-0000-000000000000"
prompt = "Tu fais ta ronde : un tour d'horizon silencieux de la machine. " * 6
open(sys.argv[1], "w").write("\n".join([
    json.dumps({"parentUuid": None, "type": "user", "message": {"role": "user", "content": prompt}, "uuid": "r1", "timestamp": "2026-09-02T09:00:00.000Z", "sessionId": S}),
    json.dumps({"parentUuid": "r1", "type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": "RAS"}]}, "uuid": "r2", "timestamp": "2026-09-02T09:00:05.000Z", "sessionId": S}),
]) + "\n")
PY
"$JARVIS" conversations >"$SB/list"
assert "la courante est marquée et comptée" grep -q "^\*$SESSION	conversation	2026-09-02 10:00	2026-09-02 10:05	2	Quelle heure est-il ?" "$SB/list"
assert "la ronde est une tâche" grep -q "^22222222-0000-0000-0000-000000000000	tâche	" "$SB/list"
assert "en JSON aussi" \
	test "$("$JARVIS" conversations --json | python3 -c 'import json,sys; x=json.load(sys.stdin); print(sum(1 for r in x if r["kind"]=="conversation"), [r["current"] for r in x if r["id"].startswith("1111")][0])')" = "1 True"

# « Oublie ce que je viens de dire » : le transcript est coupé avant le
# dernier tour (vérifié sur copie le 2026-09-02 : repris par --resume, il
# ne connaît plus l'échange), le journal perd sa ligne, la paire affichée
# recule d'un échange, et une copie est gardée.
t "undo : le dernier échange est oublié partout"
with_session
printf 'idle' >"$JARVIS_RUN/state"
mkdir -p "$JARVIS_MEMORY/journal"
printf -- '# Journal\n\n- 10:00 échange : « Quelle heure est-il ? » → « Il est dix heures. »\n- 10:05 échange : « Et la météo ? » → « Nuageux, dix-huit degrés. »\n' >"$JARVIS_MEMORY/journal/$(today).md"
printf 'Et la météo ?' >"$JARVIS_RUN/last-ask"
printf 'Nuageux, dix-huit degrés.' >"$JARVIS_RUN/last-reply"
assert "oublié" "$JARVIS" undo --quiet
assert "un seul échange reste" test "$("$JARVIS" transcript --json | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')" = 1
assert "copie gardée" bash -c "ls '$JARVIS_STATE'/undo/$SESSION-*.jsonl >/dev/null"
assert "la ligne du journal est partie" journal_lacks "Et la météo"
assert "la précédente reste" journal_has "Quelle heure est-il"
assert "la paire recule" test "$(cat "$JARVIS_RUN/last-ask")|$(cat "$JARVIS_RUN/last-reply")" = "Quelle heure est-il ?|Il est dix heures."
assert "tracé" grep -q 'oublié : « Et la météo ? »' "$JARVIS_MEMORY/trace/$(today).log"
assert "la bulle est vidée" grep -q 'macarchy.jarvis heard $' "$FAKE_SHELL_LOG"
assert "sans voix en --quiet" test ! -s "$FAKE_PIPER_LOG"
assert "oublié encore" "$JARVIS" undo --quiet
assert "plus rien à afficher" test ! -e "$JARVIS_RUN/last-ask"
assert "et plus rien à oublier" not "$JARVIS" undo --quiet

t "undo : refusé quand il est occupé ou sans conversation"
with_session
printf 'thinking' >"$JARVIS_RUN/state"
assert "occupé : refus" not "$JARVIS" undo --quiet
assert "transcript intact" test "$("$JARVIS" transcript --json | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')" = 2
printf 'idle' >"$JARVIS_RUN/state"
rm -f "$JARVIS_STATE/conversation"
assert "sans conversation : refus" not "$JARVIS" undo --quiet
assert "et il le dit à voix haute" bash -c "'$JARVIS' undo; grep -q 'rien à oublier' '$FAKE_PIPER_LOG'"

t "undo à la voix : la phrase est reconnue, et seulement elle"
assert "oublie ce que je viens de dire" "$JARVIS" undo? "Oublie ce que je viens de dire."
assert "efface mon dernier message" "$JARVIS" undo? "efface mon dernier message"
assert "annule ma dernière question" "$JARVIS" undo? "Annule ma dernière question !"
assert "forget what I just said" "$JARVIS" undo? "Forget what I just said"
assert "oublie pas le pain passe" not "$JARVIS" undo? "N'oublie pas d'acheter du pain."
assert "efface le fichier passe" not "$JARVIS" undo? "Efface le fichier de test."
with_session
printf 'idle' >"$JARVIS_RUN/state"
printf 'Et la météo ?' >"$JARVIS_RUN/last-ask"
"$JARVIS" press
mic_ready
FAKE_TRANSCRIPT="Oublie ce que je viens de dire." "$JARVIS" press
assert "il dit oublié" waitfor grep -q 'Oublié.' "$FAKE_PIPER_LOG"
assert "sans cerveau" test ! -s "$FAKE_CLAUDE_LOG"
assert "un seul échange reste" test "$("$JARVIS" transcript --json | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')" = 1
assert "état idle" waitfor state_is idle

t "voix en panne: l'état redescend au lieu de rester speaking"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_PIPER_FAIL=1 FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" "$JARVIS" ask "bonjour"
assert "piper appelé" test -s "$FAKE_PIPER_LOG"
assert "rien joué" test ! -s "$FAKE_PLAY_LOG"
assert "état idle" state_is idle

t "barge-in: la parole est coupée net et l'oreille se rouvre"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_PLAY_SLEEP=10 "$JARVIS" say "La batterie est à trente-huit pour cent." &
sayer=$!
assert "il parle" waitfor state_is speaking
pressable
"$JARVIS" press
assert "joueur coupé" waitfor grep -q 'coupé' "$FAKE_PLAY_LOG"
# Talking over him is a gesture, not a defect. It used to be filed in
# FAILURES.md, and one line there schedules a dream whose job is to rewrite
# LEARNED.md — so pressing a key manufactured persona changes.
assert "l'interruption n'est pas un échec" no_failures
assert "l'oreille se rouvre" waitfor test -s "$JARVIS_RUN/pids/record"
mic_ready
rec=$(cat "$JARVIS_RUN/pids/record" 2>/dev/null)
assert "un enregistreur tourne" alive "$rec"
# The interrupted invocation wakes from its player still believing it owns
# `speaking`. Its epoch moved when the press claimed, so it writes nothing:
# the ear the press opened is the state that survives.
wait "$sayer" 2>/dev/null
assert "l'état reste celui de la nouvelle écoute" state_is listening
"$JARVIS" cancel
assert "tout est arrêté" waitfor dead "$rec"
assert "état idle" state_is idle

# ---- the owned transition: chantier 2
t "table de transitions : le code et sa documentation sont d'accord"
assert "grille identique au témoin" bash -c \
	"JARVIS_FSM_DRYRUN=1 '$TESTS_DIR/../bin/jarvis-fsm.sh' | diff -u '$FIX/transitions.txt' -"

t "époque périmée : une étape dépassée n'écrit plus rien"
printf 'idle' >"$JARVIS_RUN/state"
# The table driven alone, without a body: an invocation claims the machine,
# somebody else claims it, and the first one is deaf from then on.
assert "l'étape dépassée ne bouge plus" bash -c '
	set -u
	. "$1"
	claim
	mine || { echo "la revendication ne se voit pas"; exit 1; }
	transition ask || { echo "idle:ask refusé"; exit 1; }
	( MY_EPOCH=""; claim )
	mine && { echo "elle se croit encore propriétaire"; exit 1; }
	transition speak && { echo "elle a écrit malgré tout"; exit 1; }
	[[ $(state) == thinking ]] || { echo "état modifié : $(state)"; exit 1; }
	exit 0
' _ "$TESTS_DIR/../bin/jarvis-fsm.sh"
printf 'idle' >"$JARVIS_RUN/state"
rm -f "$JARVIS_RUN/state.rec"
assert "couple hors table refusé" bash -c '
	set -u
	. "$1"
	transition finish && { echo "idle:finish accepté"; exit 1; }
	[[ $(state) == idle ]] || exit 1
	exit 0
' _ "$TESTS_DIR/../bin/jarvis-fsm.sh"

t "flux coupé : la réponse partielle est gardée, pas perdue"
out="$SB/reply"
# A reply longer than a pipe buffer, so a reader that walks away is felt
# whatever the scheduling: the parser's writes fail mid-stream, exactly as
# they do when a barge-in closes the voice's end.
python3 -c '
import sys
print("{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"content_block\":{\"type\":\"text\"}}}")
line = "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"%s. \"}}}"
for _ in range(400):
    print(line % ("la batterie est a trente-huit pour cent " * 8))
' >"$SB/long.jsonl"
"$TESTS_DIR/../bin/jarvis-sentences" "$out.txt" <"$SB/long.jsonl" | head -1 >/dev/null
assert "la réponse partielle est écrite" test -s "$out.txt"
assert "l'interruption est signalée" test -e "$out.txt.interrupted"
assert "la boîte noire le dit" grep -q 'flux interrompu' "$JARVIS_MEMORY/trace/$(today).log"

t "annuler pendant la parole : la demande s'arrête pour de bon"
printf 'idle' >"$JARVIS_RUN/state"
printf 'test-session-id' >"$JARVIS_STATE/conversation"
# The pair the Control Center shows. last-ask is written when the exchange
# opens and last-reply when it closes, and an exchange that never closed
# left the previous answer under the new question: on 2026-09-02 the panel
# showed the 12:41 ask over the 12:40 reply for the rest of the afternoon.
printf 'Réponse de tout à l'"'"'heure.' >"$JARVIS_RUN/last-reply"
FAKE_PLAY_SLEEP=10 FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" "$JARVIS" ask "raconte-moi une histoire" &
asker=$!
assert "la voix est sortie" waitfor test -s "$FAKE_PLAY_LOG"
assert "pendant la réponse, l'ancienne n'est plus affichée" \
	bash -c "! grep -q 'tout à l' '$JARVIS_RUN/last-reply' 2>/dev/null"
"$JARVIS" cancel
wait "$asker" 2>/dev/null
assert "joueur coupé" grep -q 'coupé' "$FAKE_PLAY_LOG"
assert "état idle" state_is idle
assert "un seul appel au cerveau" test "$(grep -c . "$FAKE_CLAUDE_LOG")" = 1
assert "aucune réponse enregistrée" test ! -e "$JARVIS_RUN/last-reply"
assert "la question reste, seule" test "$(cat "$JARVIS_RUN/last-ask")" = "raconte-moi une histoire"
assert "rien au journal" bash -c "! grep -q 'échange :' '$JARVIS_MEMORY/journal/$(today).md' 2>/dev/null"
assert "rien dans la boîte noire" bash -c "! grep -q 'reply «' '$JARVIS_MEMORY/trace/$(today).log' 2>/dev/null"
assert "aucune phrase synthétisée après l'annulation" test "$(grep -c . "$FAKE_PIPER_LOG")" = 1
assert "conversation intacte" test "$(cat "$JARVIS_STATE/conversation")" = test-session-id
assert "plus aucun groupe en vie" bash -c "! ls '$JARVIS_RUN/pids/'* 2>/dev/null"

t "annuler entre la question et le cerveau : rien n'est dépensé"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_SHELL_SLEEP=0.6 FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" "$JARVIS" ask "raconte" &
asker=$!
# The bubble is the last thing sent before the brain is called, and the fish
# holds it: waiting for that line puts the abort inside the one window where
# the brain group does not exist yet and a kill has nothing to reach. The
# question used to be asked anyway — paid for, and answered into a void.
assert "la bulle est partie, le cerveau pas encore" \
	waitfor grep -q 'macarchy.jarvis heard' "$FAKE_SHELL_LOG"
"$JARVIS" cancel
wait "$asker" 2>/dev/null
assert "état idle" state_is idle
assert "le cerveau n'a jamais été appelé" test ! -s "$FAKE_CLAUDE_LOG"
assert "et rien n'a été dit" test ! -s "$FAKE_PIPER_LOG"

t "double pression : une seule question, un seul échange"
printf 'idle' >"$JARVIS_RUN/state"
"$JARVIS" press
mic_ready
# The button under a thumb and the wake daemon's silence timer, at the same
# instant. Whichever wins the machine does the exchange; the other has to
# find it taken — by the dead time, by the ignore arm, or by the epoch.
export FAKE_TRANSCRIPT="quelle heure est-il" FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl"
"$JARVIS" press &
twin_a=$!
"$JARVIS" press &
twin_b=$!
wait "$twin_a" "$twin_b" 2>/dev/null
unset FAKE_TRANSCRIPT FAKE_CLAUDE_STREAM
assert "un seul appel au cerveau" test "$(grep -c . "$FAKE_CLAUDE_LOG")" = 1
assert "une seule ligne au journal" test "$(grep -c 'échange :' "$JARVIS_MEMORY/journal/$(today).md")" = 1
assert "une seule réponse synthétisée" test "$(grep -c . "$FAKE_PIPER_LOG")" = 1
assert "la pression perdante est écartée" \
	grep -qE 'press ignored|refused|dropped' "$JARVIS_STATE/jarvis.log"

t "un rêve ne parle pas par-dessus un échange"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_PLAY_SLEEP=0.4 FAKE_CLAUDE_STREAM="$FIX/five.jsonl" "$JARVIS" ask "fais le point" &
asker=$!
assert "il parle" waitfor state_is speaking
FAKE_CLAUDE_STREAM="$FIX/report.jsonl" "$JARVIS" dream --quiet
assert "le rêve n'a pas pris le corps" bash -c "! grep -q 'state: sleeping' '$JARVIS_STATE/jarvis.log'"
assert "le rêve n'a pas couché l'état" bash -c "[[ \$(cat '$JARVIS_RUN/state') != idle ]]"
wait "$asker" 2>/dev/null
assert "les cinq phrases sont synthétisées" test "$(grep -c . "$FAKE_PIPER_LOG")" = 5
assert "les cinq phrases sont jouées" test "$(grep -c . "$FAKE_PLAY_LOG")" = 5
assert "le rêve n'a rien dit" bash -c "! grep -q 'disque' '$FAKE_PIPER_LOG'"
assert "l'échange finit chez lui" state_is idle

t "voix en panne : l'échec est noté, pas avalé"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_PIPER_FAIL=1 FAKE_CLAUDE_STREAM="$FIX/five.jsonl" "$JARVIS" ask "fais le point"
assert "il s'arrête à la première" test "$(grep -c . "$FAKE_PIPER_LOG")" = 1
assert "échec noté en français" grep -q 'voix : synthèse impossible' "$JARVIS_MEMORY/FAILURES.md"
assert "état idle" state_is idle

t "aparté : une ronde attend son tour et arrive quand même"
# The sandbox starts busy on purpose: a mission report or a round finishing
# mid-answer used to wipe the bubble the user was reading.
FAKE_CLAUDE_STREAM="$FIX/report.jsonl" "$JARVIS" heartbeat
assert "rien n'est passé au poisson" bash -c "! grep -q 'macarchy.jarvis reply' '$FAKE_SHELL_LOG' 2>/dev/null"
assert "l'aparté est garé" grep -q 'disque' "$JARVIS_STATE/aside-pending"
assert "l'émotion est garée" test "$(cat "$JARVIS_STATE/emote-pending")" = worried
"$JARVIS" cancel
assert "l'aparté est arrivé" grep -q 'macarchy.jarvis reply.*disque' "$FAKE_SHELL_LOG"
assert "l'émotion aussi" grep -q 'macarchy.jarvis emote worried' "$FAKE_SHELL_LOG"
assert "plus rien en attente" test ! -e "$JARVIS_STATE/aside-pending"

t "un échec passager n'efface pas la conversation"
printf 'idle' >"$JARVIS_RUN/state"
printf 'test-session-id' >"$JARVIS_STATE/conversation"
# The stream produces nothing parsable; the non-streaming retry answers.
FAKE_CLAUDE_REPLY="Bien sûr." "$JARVIS" ask --quiet "et alors"
assert "réponse rattrapée" test "$(cat "$JARVIS_RUN/last-reply")" = "Bien sûr."
assert "conversation conservée" test "$(cat "$JARVIS_STATE/conversation")" = test-session-id
assert "les deux appels reprennent la même session" \
	test "$(grep -c -- '--resume test-session-id' "$FAKE_CLAUDE_LOG")" = 2

# ---- the gesture of aborting: chantier 3
t "presser pendant la réflexion : trop tôt ne fait rien, à temps annule"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_CLAUDE_SLEEP=8 FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" "$JARVIS" ask "raconte-moi une histoire" &
asker=$!
assert "il réfléchit" waitfor state_is thinking
# Inside the second and a half: a thumb that bounced on the key that STARTED
# this request must not be able to destroy it.
sleep 0.5
"$JARVIS" press
assert "la pression trop tôt ne fait rien" state_is thinking
assert "et elle est expliquée" grep -q 'press ignored: thinking for less than 1.5 s' "$JARVIS_STATE/jarvis.log"
sleep 1.8
"$JARVIS" press
wait "$asker" 2>/dev/null
assert "état idle" state_is idle
assert "passé par l'état d'annulation" grep -q 'state: cancelling' "$JARVIS_STATE/jarvis.log"
assert "le poisson a joué l'abandon" grep -q 'macarchy.jarvis abort' "$FAKE_SHELL_LOG"
assert "l'annulation est notée avec l'étape et le geste" \
	grep -qE 'annulé pendant sa réflexion après [0-9]+ s \(touche\)' "$JARVIS_MEMORY/ABORTS.md"
assert "ce n'est pas un échec" no_failures
assert "il n'a rien dit" test ! -s "$FAKE_PIPER_LOG"
assert "plus aucun groupe en vie" bash -c "! ls '$JARVIS_RUN/pids/'* 2>/dev/null"

t "annuler : sous deux secondes rien ne s'écrit, au-delà tout est daté"
printf 'transcribing' >"$JARVIS_RUN/state"
printf 'state=transcribing since=%s owner=0 epoch=3 ask=x-3\n' "$(date +%s%3N)" >"$JARVIS_RUN/state.rec"
"$JARVIS" cancel --from touche
assert "état idle" state_is idle
assert "un doigt qui ripe n'est pas un motif" no_aborts
printf 'speaking' >"$JARVIS_RUN/state"
printf 'state=speaking since=%s owner=0 epoch=4 ask=x-4\n' "$(($(date +%s%3N) - 12000))" >"$JARVIS_RUN/state.rec"
"$JARVIS" cancel --say --from voix
assert "l'étape, la durée et le geste" \
	grep -q 'annulé pendant sa réponse après 12 s (voix)' "$JARVIS_MEMORY/ABORTS.md"
assert "toujours pas un échec" no_failures
assert "et --say le dit à voix haute" grep -q 'Annulé.' "$FAKE_PIPER_LOG"
assert "état idle" state_is idle

# Parler par-dessus lui écrit dans le même journal que les autres abandons,
# et ce journal se lit — par l'utilisateur et par les rêves, qui en cherchent
# le motif. Un « barge-in » anglais au milieu d'une phrase française y était
# invisible à la relecture et illisible à la lecture.
t "barge-in : l'abandon est daté dans la langue de la maison"
printf 'speaking' >"$JARVIS_RUN/state"
printf 'state=speaking since=%s owner=%s epoch=5 ask=x-5\n' \
	"$(($(date +%s%3N) - 12000))" "$$" >"$JARVIS_RUN/state.rec"
"$JARVIS" press
assert "l'oreille s'est rouverte" state_is listening
assert "l'étape, la durée et le geste, en français" \
	grep -q 'annulé pendant sa réponse après 12 s (touche)' "$JARVIS_MEMORY/ABORTS.md"
# Les entrées seulement : le titre du fichier porte son propre nom.
assert "aucun mot anglais dans les entrées" \
	bash -c "! grep '^- \[' '$JARVIS_MEMORY/ABORTS.md' | grep -qiE 'barge|cancel|abort|press'"
assert "ce n'est toujours pas un échec" no_failures
"$JARVIS" cancel

# Le propriétaire est ce qui permet au chien de garde de distinguer une étape
# lente d'une étape dont plus personne ne s'occupe. `say` prend la machine
# sans la déplacer — et la remise à zéro du repos, appliquée à cette prise-là,
# effaçait l'identité que l'invocation venait de demander.
t "prendre une machine au repos : l'identité est gardée, pas effacée"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_PLAY_SLEEP=3 "$JARVIS" say "Bonjour." &
sayer=$!
assert "il parle" waitfor state_is speaking
assert "le propriétaire est nommé" \
	bash -c "! grep -q 'owner=0 ' '$JARVIS_RUN/state.rec'"
"$JARVIS" cancel
wait "$sayer" 2>/dev/null
assert "et le repos le relâche" grep -q 'owner=0 ' "$JARVIS_RUN/state.rec"

t "presser pendant un rêve : le rêve s'arrête vraiment, puis l'oreille s'ouvre"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_CLAUDE_SLEEP=8 FAKE_CLAUDE_STREAM="$FIX/report.jsonl" "$JARVIS" dream &
dreamer=$!
assert "il dort" waitfor state_is sleeping
assert "le rêve a un groupe" waitfor test -s "$JARVIS_RUN/pids/dream"
dream_pgid=$(cat "$JARVIS_RUN/pids/dream" 2>/dev/null)
pressable
"$JARVIS" press
assert "la session du rêve est tuée" waitfor dead "$dream_pgid"
assert "l'oreille est ouverte" state_is listening
wait "$dreamer" 2>/dev/null
assert "le rêve n'a rien journalisé" bash -c "! grep -q 'rêve :' '$JARVIS_MEMORY/journal/$(today).md' 2>/dev/null"
"$JARVIS" cancel

t "le micro parle enfin français"
printf 'idle' >"$JARVIS_RUN/state"
"$JARVIS" press
mic_ready
assert "à l'ouverture" grep -q "J'écoute… Appuie à nouveau quand tu as fini." "$FAKE_NOTIFY_LOG"
"$JARVIS" cancel
assert "à l'annulation" grep -q 'Annulé.' "$FAKE_NOTIFY_LOG"
assert "plus rien en anglais" bash -c \
	"! grep -qE 'Listening|Press again|Thinking…|No audio captured|Cancelled' '$FAKE_NOTIFY_LOG'"

t "les oreilles : la table de décision du daemon de réveil"
assert "aucun cas raté" python3 "$TESTS_DIR/test_wake_fsm.py"

# ---- the watchdog: chantier 4
t "chien de garde : une étape figée est libérée et le groupe tué"
printf 'thinking' >"$JARVIS_RUN/state"
# stderr goes nowhere: killing the group makes the little shell around it
# report « Terminated », which is the test working, not the test complaining.
bash -c '. "$1"; group_run brain sleep 30' _ "$TESTS_DIR/../bin/jarvis-fsm.sh" 2>/dev/null &
assert "le groupe tourne" waitfor test -s "$JARVIS_RUN/pids/brain"
wedged=$(cat "$JARVIS_RUN/pids/brain" 2>/dev/null)
# A record frozen three minutes ago, and an owner that is this very suite —
# alive, so only the clock can condemn it.
printf 'state=thinking since=%s owner=%s epoch=1 ask=x-1\n' "$(($(date +%s%3N) - 200000))" "$$" >"$JARVIS_RUN/state.rec"
"$JARVIS" watchdog
assert "retour au repos" state_is idle
assert "le groupe est tué" waitfor dead "$wedged"
assert "plus de fichier de groupe" test ! -e "$JARVIS_RUN/pids/brain"
assert "l'échec est noté en français" \
	grep -q 'chien de garde : figé pendant sa réflexion' "$JARVIS_MEMORY/FAILURES.md"
assert "le poisson s'inquiète" grep -q 'macarchy.jarvis emote worried' "$FAKE_SHELL_LOG"
assert "l'utilisateur est prévenu en français" \
	grep -q "s'était figé pendant sa réflexion" "$FAKE_NOTIFY_LOG"
assert "aucun appel au cerveau" test ! -s "$FAKE_CLAUDE_LOG"

t "chien de garde : une étape fraîche n'est pas touchée"
printf 'thinking' >"$JARVIS_RUN/state"
printf 'state=thinking since=%s owner=0 epoch=1 ask=x-1\n' "$(date +%s%3N)" >"$JARVIS_RUN/state.rec"
"$JARVIS" watchdog
assert "toujours en réflexion" state_is thinking
assert "aucun échec noté" no_failures

t "chien de garde : un cerveau qui écrit encore gagne un sursis, une fois"
printf 'thinking' >"$JARVIS_RUN/state"
mkdir -p "$JARVIS_MEMORY/trace"
touch "$JARVIS_MEMORY/trace/$(today).log"
printf 'state=thinking since=%s owner=0 epoch=1 ask=x-1\n' "$(($(date +%s%3N) - 200000))" >"$JARVIS_RUN/state.rec"
"$JARVIS" watchdog
assert "sursis accordé" state_is thinking
assert "et le sursis est journalisé" grep -q 'one extension' "$JARVIS_STATE/jarvis.log"
printf 'state=thinking since=%s owner=0 epoch=1 ask=x-1\n' "$(($(date +%s%3N) - 400000))" >"$JARVIS_RUN/state.rec"
"$JARVIS" watchdog
assert "mais il ne vaut qu'une fois" state_is idle

t "chien de garde : la fenêtre de relance se referme sans bruit"
printf 'followup' >"$JARVIS_RUN/state"
printf 'state=followup since=%s owner=0 epoch=1 ask=x-1\n' "$(($(date +%s%3N) - 20000))" >"$JARVIS_RUN/state.rec"
"$JARVIS" watchdog
assert "refermée" state_is idle
assert "sans échec" no_failures
assert "sans rien dire" test ! -s "$FAKE_NOTIFY_LOG"

t "chien de garde : une décision périmée ne tue rien"
printf 'idle' >"$JARVIS_RUN/state"
rm -f "$JARVIS_RUN/state.rec"
assert "la revendication est refusée quand l'époque a bougé" bash -c '
	set -u
	. "$1"
	claim
	seen=$REC_EPOCH
	( MY_EPOCH=""; claim )
	claim_if "$seen" cancel && { echo "elle a revendiqué malgré tout"; exit 1; }
	[[ $(state) == idle ]] || { echo "état modifié : $(state)"; exit 1; }
	rec_read
	claim_if "$REC_EPOCH" cancel || { echo "la décision fraîche est refusée"; exit 1; }
	[[ $(state) == cancelling ]] || { echo "état : $(state)"; exit 1; }
	exit 0
' _ "$TESTS_DIR/../bin/jarvis-fsm.sh"

t "tick : la pulsation commence par libérer la machine"
printf 'quota %s' "$(($(date +%s) + 3600))" >"$JARVIS_STATE/brain"
printf 'thinking' >"$JARVIS_RUN/state"
printf 'state=thinking since=%s owner=0 epoch=1 ask=x-1\n' "$(($(date +%s%3N) - 400000))" >"$JARVIS_RUN/state.rec"
"$JARVIS" tick
assert "machine libérée" state_is idle
assert "aucun appel cerveau" test ! -s "$FAKE_CLAUDE_LOG"
assert "l'heure de silence est écrite pour le poisson" test -s "$JARVIS_STATE/quiet"
assert "le bilan de santé du jour a tourné" test -e "$JARVIS_STATE/last-doctor"
assert "seul le rouge y est gardé" bash -c "! grep -q '^✓' '$JARVIS_STATE/last-doctor'"
# The log line rather than the notification: at night the diagnosis still
# runs and only its notification is held back, so this assertion is the one
# that does not depend on the hour the suite is run at.
assert "et ce qui vient de rougir est signalé" \
	grep -q 'doctor: nouveau(x) problème(s)' "$JARVIS_STATE/jarvis.log"
# Seen on the live machine before it was fixed: « a;b c » instead of
# « a; b; c », because paste cycles through the delimiters it is given.
assert "en une ligne lisible" bash -c \
	"! grep -q 'nouveau(x) problème(s).*;[^ ]' '$JARVIS_STATE/jarvis.log'"

t "tick : le bilan ne signale que ce qui vient de rougir"
printf 'idle' >"$JARVIS_RUN/state"
# Everything that is red today was already red yesterday: nothing to say.
"$JARVIS" doctor --quiet | sort >"$JARVIS_STATE/last-doctor"
"$JARVIS" tick
assert "rien de neuf, rien de dit" bash -c "! grep -q 'bilan de santé' '$FAKE_NOTIFY_LOG'"

t "doctor : une machine bloquée est signalée avec son remède"
printf 'speaking' >"$JARVIS_RUN/state"
printf 'state=speaking since=%s owner=0 epoch=2 ask=x-2\n' "$(($(date +%s%3N) - 3600000))" >"$JARVIS_RUN/state.rec"
"$JARVIS" doctor --quiet >"$SB/doctor.out"
rc=$?
assert "la ligne et le remède" \
	grep -q 'machine bloquée en « speaking » depuis 60 min (omarchy-jarvis cancel)' "$SB/doctor.out"
assert "--quiet ne montre que le rouge" bash -c "! grep -q '^✓\|^ℹ' '$SB/doctor.out'"
assert "le code de sortie compte les problèmes" test "$rc" = "$(grep -c '^✗' "$SB/doctor.out")"
printf 'idle' >"$JARVIS_RUN/state"
rm -f "$JARVIS_RUN/state.rec"
"$JARVIS" doctor >"$SB/doctor2.out"
assert "au repos, pas de ligne de blocage" bash -c "! grep -q 'machine bloquée' '$SB/doctor2.out'"
assert "et l'état est vert" grep -q '✓ état : idle' "$SB/doctor2.out"

# Le bilan a déclaré le micro vert toute la journée du 2026-09-01 : il ne
# regardait que la TAILLE du fichier, et un micro coupé en produit un gros.
t "doctor : un micro qui ne capte rien ne passe plus pour vert"
printf 'idle' >"$JARVIS_RUN/state"
FAKE_RECORD_ZEROS=1 "$JARVIS" doctor --quiet --mic >"$SB/mic.out"
assert "la capture muette est signalée" grep -q '^✗ micro : capture' "$SB/mic.out"
"$JARVIS" doctor --quiet --mic >"$SB/mic2.out"
assert "et une capture vivante reste verte" not grep -q '^✗ micro : capture' "$SB/mic2.out"

t "doctor : une planche manquante et un poisson périmé se voient"
"$JARVIS" look
assert "le poisson est conforme" bash -c '"$1" doctor | grep -q "✓ poisson conforme"' _ "$JARVIS"
rm -f "$JARVIS_SPRITES/worried.png"
assert "planche manquante" bash -c '"$1" doctor | grep -q "✗ planches du poisson"' _ "$JARVIS"
printf 'B1 E1 M1 T1 braise\n' >"$JARVIS_SPRITES/.look"
assert "poisson périmé" bash -c '"$1" doctor | grep -q "✗ poisson conforme"' _ "$JARVIS"

t "un seul échec ne programme plus un rêve"
printf 'idle' >"$JARVIS_RUN/state"
printf -- '- [x] un échec isolé\n' >"$JARVIS_MEMORY/FAILURES.md"
"$JARVIS" maybe-dream
assert "aucun rêve" test ! -s "$FAKE_CLAUDE_LOG"
printf -- '- [x] un\n- [x] deux\n- [x] trois\n' >"$JARVIS_MEMORY/FAILURES.md"
FAKE_CLAUDE_STREAM="$FIX/report.jsonl" "$JARVIS" maybe-dream
assert "un motif, lui, se consolide" test -s "$FAKE_CLAUDE_LOG"

# ---- look
t "look: génère les planches depuis l'âme"
"$JARVIS" look
# By name, not by count: the sheets the mascot actually asks for by name are
# the contract, and counting them meant every new sheet added to
# sprites/generate.py arrived as a red line in a file its author does not own.
assert "toutes les planches attendues" bash -c '
	for sheet in idle listening thinking speaking cancel sleeping tired dnd worried proud curious celebrate; do
		[[ -e "$1/$sheet.png" ]] || { echo "planche manquante : $sheet"; exit 1; }
	done' _ "$JARVIS_SPRITES"
assert "canevas 72 de large" bash -c "python3 '$TESTS_DIR/../sprites/preview.py' --no-ascii --scale 1 --out /dev/null '$JARVIS_SPRITES/tired.png' | grep -q '144x56'"
assert "le poisson a rechargé ses planches" grep -q 'macarchy.jarvis reload' "$FAKE_SHELL_LOG"

# ---- every shape configuration, every part-wise move, attached
t "sprites: les 256 configurations s'attachent"
assert "check.py à zéro échec" python3 "$TESTS_DIR/../sprites/check.py"

# ---- save (« enregistre ça ») and greet
t "save: un lien copié devient un .url dans la boîte"
FAKE_CLIP="https://example.org/article" "$JARVIS" save
assert "fichier .url" bash -c "ls '$JARVIS_BOX/input/'lien-*.url"
assert "contenu = le lien" bash -c "grep -qx 'https://example.org/article' '$JARVIS_BOX/input/'lien-*.url"
t "save: sans presse-papier, la sélection primaire sert"
FAKE_CLIP="" FAKE_PRIMARY="https://example.org/selected" "$JARVIS" save
assert "lien depuis la sélection" bash -c "grep -qx 'https://example.org/selected' '$JARVIS_BOX/input/'lien-*.url"
t "save: un texte copié devient une note"
FAKE_CLIP="trois lignes de notes" "$JARVIS" save
assert "fichier .md" bash -c "ls '$JARVIS_BOX/input/'note-*.md"
t "greet: résume ce qui s'est passé, une fois par demi-heure"
printf 'idle' >"$JARVIS_RUN/state"
# Seeded relative to now: the journal holds clock faces, so a fixed 08:00
# would make this test depend on the hour it is run at.
mkdir -p "$JARVIS_MEMORY/journal"
printf -- '- %s ronde : Le disque est presque plein.\n- %s digestion : contrat.pdf → knowledge/inbox/contrat.md\n' \
	"$(date -d '-2 hours' +%H:%M)" "$(date -d '-1 hour' +%H:%M)" >"$JARVIS_MEMORY/journal/$(today).md"
touch -d '3 hours ago' "$JARVIS_RUN/last-ask"
"$JARVIS" greet
assert "greet journalisé dans le log" bash -c "grep -q 'greet: Le disque est presque plein.' '$JARVIS_STATE/jarvis.log'"
assert "bulle envoyée au poisson" grep -q "macarchy.jarvis reply Pendant ton absence" "$FAKE_SHELL_LOG"
assert "second appel silencieux" bash -c "! '$JARVIS' greet 2>&1 | grep -q ."

t "greet: une absence d'une nuit raconte quand même la matinée"
mkdir -p "$JARVIS_MEMORY/journal"
printf -- '- %s ronde : Le disque est presque plein.\n' "$(date -d '-1 hour' +%H:%M)" >"$JARVIS_MEMORY/journal/$(today).md"
touch -d 'yesterday 18:00' "$JARVIS_RUN/last-ask"
"$JARVIS" greet
assert "la ronde du matin est racontée" bash -c "grep -q 'greet: Le disque est presque plein.' '$JARVIS_STATE/jarvis.log'"

# ---- two clocks, one pulse
#
# The mascot's five-minute Timer and the systemd minute both run `tick`, and
# nothing kept them apart: a beat landing inside a beat busy closing a stale
# conversation found the flag still there and closed it a second time.
# ---- routines: what he does at a fixed hour
#
# memory/ROUTINES.md, one line per routine, run from the pulse. The hour is
# JARVIS_NOW here, so a test can stand at ten o'clock whenever it runs.
tick_at() { JARVIS_NOW="$(date -d "today $1" +%s)" "$JARVIS" tick; }
t "routines : la grammaire, la liste, l'interrupteur"
printf 'idle' >"$JARVIS_RUN/state"
assert "ajout d'une quotidienne" "$JARVIS" routine add "18:30 * say Pense à brancher le Mac."
assert "ajout d'une semaine" "$JARVIS" routine add "- 08:00 lun-ven ask --quiet Briefing du matin"
assert "ajout d'une ponctuelle" "$JARVIS" routine add "2030-01-01 09:00 once notify Bonne année"
assert "une ligne sans verbe est refusée" not "$JARVIS" routine add "08:00 * bonjour"
assert "un jour inconnu est refusé" not "$JARVIS" routine add "08:00 lun-fri say x"
assert "une heure impossible est refusée" not "$JARVIS" routine add "25:00 * say x"
assert "l'en-tête du fichier est resté" grep -q '^# ROUTINES.md' "$JARVIS_MEMORY/ROUTINES.md"
"$JARVIS" routines >"$SB/r"
assert "trois routines numérotées" test "$(cut -f1,2,3,5 "$SB/r" | paste -sd'|')" = "1	on	18:30	say|2	on	08:00	ask --quiet|3	on	2030-01-01 09:00	notify"
assert "la prochaine est calculée" test "$(cut -f7 "$SB/r" | sort -n | head -1)" -gt "$(date +%s)"
assert "off" "$JARVIS" routine 2 off
assert "la ligne porte off" grep -q '^- off 08:00 lun-ven ask --quiet Briefing du matin$' "$JARVIS_MEMORY/ROUTINES.md"
assert "et ne compte plus" test "$("$JARVIS" status | grep '^routines=')" = "routines=2"
assert "on" "$JARVIS" routine 2 on
assert "la ligne est rétablie" grep -q '^- 08:00 lun-ven ask --quiet Briefing du matin$' "$JARVIS_MEMORY/ROUTINES.md"
assert "delete" "$JARVIS" routine 3 delete
assert "deux restent" test "$("$JARVIS" routines --json | python3 -c 'import json,sys; x=json.load(sys.stdin); print(len(x), x[0]["text"], x[1]["days"])')" = "2 Pense à brancher le Mac. lun-ven"
assert "un numéro inconnu est refusé" not "$JARVIS" routine 9 off

t "routines : le pouls lance ce qui est dû, une fois, rattrape dix minutes, saute au-delà"
printf 'idle' >"$JARVIS_RUN/state"
soul_with "rondes: non"
sed -i 's/^- silence: .*/- silence: non/' "$SB/SOUL.md"
touch "$JARVIS_STATE/last-doctor-run"
"$JARVIS" routine add "10:00 * say Il est dix heures." >/dev/null
"$JARVIS" routine add "09:55 * notify Cinq minutes avant." >/dev/null
"$JARVIS" routine add "09:30 * say Trop tôt." >/dev/null
"$JARVIS" routine add "$(date +%F) 10:00 once say Une seule fois." >/dev/null
"$JARVIS" routine add "off 10:00 * say Jamais." >/dev/null
tick_at 10:00
assert "la routine de dix heures est dite" grep -q 'Il est dix heures.' "$FAKE_PIPER_LOG"
assert "la ponctuelle aussi" grep -q 'Une seule fois.' "$FAKE_PIPER_LOG"
assert "celle de 9h55 est rattrapée" grep -q 'Cinq minutes avant.' "$FAKE_NOTIFY_LOG"
assert "celle de 9h30 est sautée et journalisée" journal_has "routine sautée (machine endormie) : 09:30 \* say Trop tôt."
assert "et pas dite" not grep -q 'Trop tôt.' "$FAKE_PIPER_LOG"
assert "la désactivée ne tire pas" not grep -q 'Jamais.' "$FAKE_PIPER_LOG"
assert "journalisée" journal_has "routine : 10:00 \* say Il est dix heures."
assert "tracée" grep -q '⏰ routine : 10:00' "$JARVIS_MEMORY/trace/$(today).log"
assert "la ponctuelle a disparu du fichier" not grep -q 'Une seule fois' "$JARVIS_MEMORY/ROUTINES.md"
tick_at 10:01
assert "une minute plus tard, rien ne se répète" test "$(grep -c 'Il est dix heures.' "$FAKE_PIPER_LOG")" = 1
assert "les tampons sont posés" bash -c "ls '$JARVIS_STATE'/routines/* | wc -l | grep -q 4"

t "routines : la nuit et l'occupation changent la forme, pas le rendez-vous"
printf 'idle' >"$JARVIS_RUN/state"
soul_with "rondes: non"
sed -i 's/^- silence: .*/- silence: 0-24/' "$SB/SOUL.md"
touch "$JARVIS_STATE/last-doctor-run"
"$JARVIS" routine add "10:00 * say Bonne nuit." >/dev/null
"$JARVIS" routine add "10:00 * ask Quelle heure est-il ?" >/dev/null
tick_at 10:00
assert "say devient notification" grep -q 'Bonne nuit.' "$FAKE_NOTIFY_LOG"
assert "sans voix" test ! -s "$FAKE_PIPER_LOG"
assert "ask est posée au cerveau" grep -q 'Quelle heure est-il' "$FAKE_CLAUDE_LOG"
assert "et sans voix non plus" test ! -s "$FAKE_PIPER_LOG"
sed -i 's/^- silence: .*/- silence: non/' "$SB/SOUL.md"
printf 'speaking' >"$JARVIS_RUN/state"
"$JARVIS" routine add "10:00 * say Pendant qu'il parle." >/dev/null
tick_at 10:00
assert "occupé : notification" grep -q "Pendant qu'il parle." "$FAKE_NOTIFY_LOG"
printf 'idle' >"$JARVIS_RUN/state"
printf 'quota %s' "$(( $(date +%s) + 3600 ))" >"$JARVIS_STATE/brain"
"$JARVIS" routine add "10:00 * ask --quiet Fais le point." >/dev/null
"$JARVIS" routine add "10:00 * notify Toujours là." >/dev/null
tick_at 10:00
assert "en quota, la question est sautée" journal_has "routine sautée (cerveau en quota) : 10:00 \* ask --quiet Fais le point."
assert "mais la notification passe" grep -q 'Toujours là.' "$FAKE_NOTIFY_LOG"

t "tick : deux pulsations à la fois n'en font qu'une"
printf 'idle' >"$JARVIS_RUN/state"
soul_with "rondes: non"
sed -i 's/^- silence: .*/- silence: non/' "$SB/SOUL.md"
printf 'stale-session' >"$JARVIS_STATE/conversation"
touch -d '-9 hours' "$JARVIS_STATE/conversation"
touch "$JARVIS_STATE/last-doctor-run"
FAKE_CLAUDE_REPLY="Nous avons parlé du disque." FAKE_CLAUDE_SLEEP=1 "$JARVIS" tick &
first=$!
sleep 0.3
FAKE_CLAUDE_REPLY="Nous avons parlé du disque." "$JARVIS" tick
wait "$first"
assert "une seule rotation au journal" \
	test "$(grep -c 'conversation résumée' "$JARVIS_MEMORY/journal/$(today).md")" = 1
assert "un seul appel au cerveau" test "$(grep -c -- '--resume stale-session' "$FAKE_CLAUDE_LOG")" = 1

# ---- a mission's report survives a relative invocation
#
# The mission's subshell `cd`s into its directory before it says its report,
# and called itself through `$0`: relative — `bin/jarvis dispatch` from the
# checkout — that named nothing from there, and the say vanished into its
# own `2>/dev/null`.
t "dispatch : le compte rendu est dit même lancé par un chemin relatif"
printf 'idle' >"$JARVIS_RUN/state"
soul_with "rondes: non"
sed -i 's/^- silence: .*/- silence: non/' "$SB/SOUL.md"
# The mission's directory sits deeper than the caller's, so a path relative
# to the one names nothing from the other — siblings would resolve alike.
mkdir -p "$SB/cwd" "$SB/projet/sous"
rel=$(realpath --relative-to="$SB/cwd" "$JARVIS")
(cd "$SB/cwd" && FAKE_CLAUDE_STREAM="$FIX/digest-ok.jsonl" "$rel" dispatch --dir "$SB/projet/sous" "range ce dossier" >/dev/null)
assert "mission journalisée" waitfor journal_has "mission terminée : J'ai retenu la fondue."
assert "et dite à voix haute" waitfor grep -q "J'ai retenu la fondue." "$FAKE_PIPER_LOG"

# ---- rotate
t "rotate: résume et clôt la conversation"
printf 'test-session-id' >"$JARVIS_STATE/conversation"
FAKE_CLAUDE_REPLY="Nous avons parlé de la fondue et de la boîte Jarvis." "$JARVIS" rotate
assert "résumé écrit" bash -c "grep -q 'parlé de la fondue' '$JARVIS_MEMORY/CONVERSATION.md'"
assert "flag effacé" test ! -e "$JARVIS_STATE/conversation"
assert "reprise de la bonne session" bash -c "grep -q -- '--resume test-session-id' '$FAKE_CLAUDE_LOG'"
assert "journal rotation" journal_has "conversation résumée et close"

t "rotate: le quota garde la conversation"
printf 'test-session-id' >"$JARVIS_STATE/conversation"
FAKE_CLAUDE_REPLY="You've hit your weekly limit · resets 8pm" "$JARVIS" rotate
assert "flag conservé" test -e "$JARVIS_STATE/conversation"
assert "statut quota" bash -c "grep -q '^quota ' '$JARVIS_STATE/brain'"

t "rotate: session perdue → close sans résumé"
printf 'test-session-id' >"$JARVIS_STATE/conversation"
FAKE_CLAUDE_REPLY="" "$JARVIS" rotate
assert "flag effacé" test ! -e "$JARVIS_STATE/conversation"
assert "journal sans résumé" journal_has "close sans résumé"

# ---- tick
t "tick: le quota bloque toute autonomie"
printf 'quota %s' "$(( $(date +%s) + 3600 ))" >"$JARVIS_STATE/brain"
printf 'idle' >"$JARVIS_RUN/state"
"$JARVIS" tick
assert "boîte échafaudée" test -d "$JARVIS_BOX/input/.work"
assert "aucun appel cerveau" test ! -s "$FAKE_CLAUDE_LOG"

printf '\n%d réussite(s), %d échec(s)\n' "$pass" "$fail"
exit "$((fail > 0))"
